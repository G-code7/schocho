                {{ section.settings.col3_score }}
              </div>
              <div class="chocho-radial__mob-score-name-{{ section_id }}">{{ section.settings.col3_label }}</div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</section>

<script>
(function() {
  const SID       = '{{ section_id }}';
  const canvas    = document.getElementById('chocho-canvas-' + SID);
  const linesSvg  = document.getElementById('chocho-lines-' + SID);
  if (!canvas || !linesSvg) return;

  const nodes     = canvas.querySelectorAll('[data-node]');
  const total     = nodes.length;
  if (total === 0) return;

  const CANVAS_PX    = {{ section.settings.canvas_size }};
  const RADIUS_FRAC  = {{ section.settings.orbit_radius }};   /* 0–1 fraction of half-canvas */
  const ACCENT       = '{{ section.settings.accent_color }}';
  const HUB_COLOR    = '{{ section.settings.hub_color }}';
  const LINE_OPACITY = 0.35;

  /* We work in SVG-space (0..CANVAS_PX) then convert to % for CSS */
  const cx = CANVAS_PX / 2;
  const cy = CANVAS_PX / 2;
  const r  = (CANVAS_PX / 2) * RADIUS_FRAC;

  function polarToXY(index, count) {
    /* Start at top (−π/2) and go clockwise */
    const angle = (index / count) * 2 * Math.PI - Math.PI / 2;
    return {
      x: cx + r * Math.cos(angle),
      y: cy + r * Math.sin(angle),
      angle: angle
    };
  }

  nodes.forEach(function(node, i) {
    const pos = polarToXY(i, total);

    /* Position node as % so it's responsive */
    node.style.left = (pos.x / CANVAS_PX * 100) + '%';
    node.style.top  = (pos.y / CANVAS_PX * 100) + '%';

    /* Left-half nodes: flip so label is between node and edge */
    const degNorm = ((pos.angle * 180 / Math.PI) + 360) % 360;
    if (degNorm > 105 && degNorm < 255) {
      node.classList.add('is-left');
    }

    /* ── SVG connector line ── */
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', cx);
    line.setAttribute('y1', cy);
    line.setAttribute('x2', pos.x);
    line.setAttribute('y2', pos.y);
    line.setAttribute('stroke', ACCENT);
    line.setAttribute('stroke-width', '1.5');
    line.setAttribute('stroke-dasharray', '5 5');
    line.setAttribute('opacity', LINE_OPACITY);
    linesSvg.appendChild(line);

    /* ── Orbit dot (midpoint pulse) ── */
    const dotFrac = 0.68;
    const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dot.setAttribute('cx', cx + dotFrac * r * Math.cos(pos.angle));
    dot.setAttribute('cy', cy + dotFrac * r * Math.sin(pos.angle));
    dot.setAttribute('r', '4');
    dot.setAttribute('fill', ACCENT);
    dot.setAttribute('opacity', '0.45');
    linesSvg.appendChild(dot);

    /* ── Scroll-in animation (staggered) ── */
    const delay = i * 80;
    setTimeout(function() {
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('wt-in');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      observer.observe(node);
    }, delay);
  });

  /* ── Orbit ring (SVG) ── */
  const ring = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  ring.setAttribute('cx', cx);
  ring.setAttribute('cy', cy);
  ring.setAttribute('r', r);
  ring.setAttribute('fill', 'none');
  ring.setAttribute('stroke', ACCENT);
  ring.setAttribute('stroke-width', '0.8');
  ring.setAttribute('stroke-dasharray', '3 8');
  ring.setAttribute('opacity', '0.25');
  linesSvg.insertBefore(ring, linesSvg.firstChild);

  /* ── Mobile: tap to expand description ── */
  document.querySelectorAll('[data-mob-row]').forEach(function(row) {
    function toggle() {
      const isOpen = row.classList.contains('open');
      row.classList.toggle('open', !isOpen);
      row.setAttribute('aria-expanded', String(!isOpen));
    }
    row.addEventListener('click', toggle);
    row.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });

})();
</script>

