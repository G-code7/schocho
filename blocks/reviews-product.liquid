{%- liquid
  assign bid = block.id
-%}

{% style %}
  #rc-{{ bid }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.bg_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_x }}px {{ block.settings.padding_bottom }}px;
  }
  #rc-{{ bid }} .rc-container { max-width: {{ block.settings.max_width }}px; margin: 0 auto; }

  /* Header */
  #rc-{{ bid }} .rc-header { text-align: {{ block.settings.header_align }}; margin-bottom: {{ block.settings.header_margin_bottom }}px; }
  #rc-{{ bid }} .rc-title {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
    line-height: 1.2;
    {% if block.settings.title_uppercase %}text-transform: uppercase;{% endif %}
  }
  #rc-{{ bid }} .rc-subtitle { font-size: {{ block.settings.subtitle_size }}px; color: {{ block.settings.subtitle_color }}; margin: 0; line-height: 1.5; }

  /* Resumen de calificación */
  #rc-{{ bid }} .rc-summary { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 0 0 {{ block.settings.header_margin_bottom }}px; }
  #rc-{{ bid }} .rc-summary-avg { font-size: 40px; font-weight: 700; line-height: 1; color: {{ block.settings.title_color }}; }
  #rc-{{ bid }} .rc-summary .rc-stars { margin: 0; }
  #rc-{{ bid }} .rc-summary .rc-star { width: 22px; height: 22px; }
  #rc-{{ bid }} .rc-summary-count { font-size: 14px; color: {{ block.settings.subtitle_color }}; }

  /* Carrusel */
  #rc-{{ bid }} .rc-carousel-outer { position: relative; }
  #rc-{{ bid }} .rc-carousel-viewport { overflow: hidden; }
  #rc-{{ bid }} .rc-carousel-track {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform {{ block.settings.transition_duration }}ms ease;
    will-change: transform;
  }

  /* Tarjeta (el contenedor impone el estilo a los bloques hijos) */
  #rc-{{ bid }} .rc-card {
    flex: 0 0 calc((100% - ({{ block.settings.visible_cards | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.visible_cards }});
    box-sizing: border-box;
    background-color: {{ block.settings.card_bg }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  #rc-{{ bid }} .rc-card-media { position: relative; width: 100%; padding-top: {{ block.settings.image_ratio }}%; overflow: hidden; background-color: {{ block.settings.image_bg }}; flex-shrink: 0; }
  #rc-{{ bid }} .rc-card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ block.settings.image_position }}; display: block; }
  #rc-{{ bid }} .rc-card-body { padding: {{ block.settings.card_padding }}px; display: flex; flex-direction: column; flex: 1; }
  #rc-{{ bid }} .rc-card-text { font-size: {{ block.settings.review_text_size }}px; color: {{ block.settings.review_text_color }}; line-height: {{ block.settings.review_text_lh }}; margin: 0 0 {{ block.settings.text_margin_bottom }}px 0; flex: 1; }
  #rc-{{ bid }} .rc-card-author {
    font-size: {{ block.settings.author_size }}px;
    font-weight: {{ block.settings.author_weight }};
    color: {{ block.settings.author_color }};
    margin: 0;
    {% if block.settings.author_uppercase %}text-transform: uppercase;{% endif %}
  }

  /* Estrellas */
  #rc-{{ bid }} .rc-stars { display: inline-flex; gap: 2px; margin: 0 0 10px; line-height: 0; }
  #rc-{{ bid }} .rc-star { width: 18px; height: 18px; fill: {{ block.settings.star_empty_color }}; }
  #rc-{{ bid }} .rc-star.is-full { fill: {{ block.settings.star_color }}; }

  /* Meta: autor + verificado + fecha */
  #rc-{{ bid }} .rc-card-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  #rc-{{ bid }} .rc-verified { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: {{ block.settings.star_color }}; }
  #rc-{{ bid }} .rc-verified svg { width: 14px; height: 14px; fill: {{ block.settings.star_color }}; }
  #rc-{{ bid }} .rc-card-date { margin: 6px 0 0; font-size: 12px; color: {{ block.settings.subtitle_color }}; opacity: 0.7; }

  /* Flechas */
  #rc-{{ bid }} .rc-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: {{ block.settings.arrow_radius }}px;
    background-color: {{ block.settings.arrow_bg }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
    opacity: {{ block.settings.arrow_opacity | divided_by: 100.0 }};
  }
  #rc-{{ bid }} .rc-arrow:hover { background-color: {{ block.settings.arrow_bg_hover }}; opacity: 1; transform: translateY(-50%) scale(1.06); }
  #rc-{{ bid }} .rc-arrow svg {
    width: {{ block.settings.arrow_icon_size }}px;
    height: {{ block.settings.arrow_icon_size }}px;
    fill: none;
    stroke: {{ block.settings.arrow_icon_color }};
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #rc-{{ bid }} .rc-arrow-prev { left: -{{ block.settings.arrow_offset }}px; }
  #rc-{{ bid }} .rc-arrow-next { right: -{{ block.settings.arrow_offset }}px; }
  #rc-{{ bid }} .rc-arrow[hidden] { display: none !important; }

  /* Dots */
  #rc-{{ bid }} .rc-dots { display: flex; justify-content: center; align-items: center; gap: {{ block.settings.dots_gap }}px; margin-top: {{ block.settings.dots_margin_top }}px; }
  #rc-{{ bid }} .rc-dot {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: {{ block.settings.dot_opacity | divided_by: 100.0 }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  #rc-{{ bid }} .rc-dot.active { background-color: {{ block.settings.dot_active_color }}; opacity: 1; transform: scale(1.3); }

  /* Responsive */
  @media screen and (max-width: 990px) {
    #rc-{{ bid }} { padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_x_mobile }}px {{ block.settings.padding_bottom_mobile }}px; }
    #rc-{{ bid }} .rc-card { flex: 0 0 calc((100% - ({{ block.settings.visible_cards_tablet | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.visible_cards_tablet }}); }
    #rc-{{ bid }} .rc-arrow-prev { left: 0; }
    #rc-{{ bid }} .rc-arrow-next { right: 0; }
    #rc-{{ bid }} .rc-title { font-size: {{ block.settings.title_size | times: 0.78 | round }}px; }
  }
  @media screen and (max-width: 640px) {
    #rc-{{ bid }} .rc-card { flex: 0 0 {{ block.settings.card_width_mobile }}%; }
    #rc-{{ bid }} .rc-arrow { width: {{ block.settings.arrow_size | times: 0.8 | round }}px; height: {{ block.settings.arrow_size | times: 0.8 | round }}px; }
    {% if block.settings.hide_arrows_mobile %}#rc-{{ bid }} .rc-arrow { display: none !important; }{% endif %}
  }
  @media (prefers-reduced-motion: reduce) {
    #rc-{{ bid }} .rc-carousel-track,
    #rc-{{ bid }} .rc-dot,
    #rc-{{ bid }} .rc-arrow { transition: none; }
  }
{% endstyle %}

<div id="rc-{{ bid }}" class="rc-root" {{ block.shopify_attributes }}>
  <div class="rc-container">

    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="rc-header">
        {% if block.settings.title != blank %}<h2 class="rc-title">{{ block.settings.title }}</h2>{% endif %}
        {% if block.settings.subtitle != blank %}<p class="rc-subtitle">{{ block.settings.subtitle }}</p>{% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_summary %}
      <div class="rc-summary" data-rc-summary hidden>
        <span class="rc-summary-avg" data-rc-avg></span>
        <span class="rc-stars" data-rc-summary-stars role="img" aria-label="">
          {% for i in (1..5) %}<svg class="rc-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"/></svg>{% endfor %}
        </span>
        <span class="rc-summary-count" data-rc-count></span>
      </div>
    {% endif %}

    <div class="rc-carousel-outer">
      <button class="rc-arrow rc-arrow-prev" data-rc-prev type="button" aria-label="Reseñas anteriores" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="rc-carousel-viewport">
        <div class="rc-carousel-track" data-rc-track>
          {% content_for 'blocks' %}
        </div>
      </div>

      <button class="rc-arrow rc-arrow-next" data-rc-next type="button" aria-label="Reseñas siguientes" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    {% if block.settings.show_dots %}
      <div class="rc-dots" data-rc-dots></div>
    {% endif %}

  </div>
</div>

<script>
(function () {
  var root = document.getElementById('rc-{{ bid }}');
  if (!root) return;
  var track = root.querySelector('[data-rc-track]');
  if (!track) return;
  var prevBtn = root.querySelector('[data-rc-prev]');
  var nextBtn = root.querySelector('[data-rc-next]');
  var dotsBox = root.querySelector('[data-rc-dots]');
  var cards   = Array.prototype.slice.call(track.querySelectorAll('[data-rc-card]'));

  computeSummary();

  if (!cards.length) {
    if (prevBtn) prevBtn.hidden = true;
    if (nextBtn) nextBtn.hidden = true;
    if (dotsBox) dotsBox.style.display = 'none';
    return;
  }

  var gap = {{ block.settings.card_gap }};
  var current = 0;

  function getVisible() {
    if (window.innerWidth <= 640) return {{ block.settings.visible_cards_mobile }};
    if (window.innerWidth <= 990) return {{ block.settings.visible_cards_tablet }};
    return {{ block.settings.visible_cards }};
  }
  function maxIndex() { return Math.max(0, cards.length - getVisible()); }
  function cardWidth() { return cards[0].getBoundingClientRect().width + gap; }

  function computeSummary() {
    var box = root.querySelector('[data-rc-summary]');
    if (!box) return;
    var all = Array.prototype.slice.call(track.querySelectorAll('[data-rc-card]'));
    var sum = 0, n = 0;
    all.forEach(function (c) {
      var r = parseInt(c.getAttribute('data-rating') || '0', 10);
      if (r > 0) { sum += r; n++; }
    });
    if (n === 0) { box.hidden = true; return; }
    var avg = sum / n;
    var avgStr = avg.toFixed(1).replace('.', ',');
    var avgEl = box.querySelector('[data-rc-avg]');
    if (avgEl) avgEl.textContent = avgStr;
    var cntEl = box.querySelector('[data-rc-count]');
    if (cntEl) cntEl.textContent = 'Based on ' + n + (n === 1 ? ' review' : ' reviews');
    var wrap = box.querySelector('[data-rc-summary-stars]');
    if (wrap) {
      wrap.setAttribute('aria-label', avgStr + ' de 5 estrellas');
      var stars = wrap.querySelectorAll('.rc-star');
      var rounded = Math.round(avg);
      for (var i = 0; i < stars.length; i++) stars[i].classList.toggle('is-full', i < rounded);
    }
    box.hidden = false;
  }

  function buildDots() {
    if (!dotsBox) return;
    dotsBox.innerHTML = '';
    var n = maxIndex() + 1;
    if (n <= 1) { dotsBox.style.display = 'none'; return; }
    dotsBox.style.display = '';
    for (var i = 0; i < n; i++) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'rc-dot' + (i === current ? ' active' : '');
      b.setAttribute('data-dot', i);
      b.setAttribute('aria-label', 'Ir a la posición ' + (i + 1));
      b.addEventListener('click', (function (idx) { return function () { goTo(idx); }; })(i));
      dotsBox.appendChild(b);
    }
  }

  function syncArrows() {
    var hide = cards.length <= getVisible();
    if (prevBtn) { prevBtn.hidden = hide; prevBtn.style.opacity = current === 0 ? '0.3' : ''; }
    if (nextBtn) { nextBtn.hidden = hide; nextBtn.style.opacity = current === maxIndex() ? '0.3' : ''; }
  }

  function goTo(index) {
    current = Math.max(0, Math.min(index, maxIndex()));
    track.style.transform = 'translateX(-' + (current * cardWidth()) + 'px)';
    if (dotsBox) {
      var ds = dotsBox.querySelectorAll('.rc-dot');
      for (var i = 0; i < ds.length; i++) ds[i].classList.toggle('active', i === current);
    }
    syncArrows();
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });

  var tx = 0;
  track.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].screenX; }, { passive: true });
  track.addEventListener('touchend', function (e) {
    var diff = tx - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
  }, { passive: true });

  root.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowLeft') goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });

  var rt;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () { buildDots(); goTo(Math.min(current, maxIndex())); }, 150);
  });

  buildDots();
  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Reviews de producto",
  "tag": null,
  "class": "rc-block",
  "blocks": [
    {
      "type": "_review-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "── Contenedor ──"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 800,
      "max": 1920,
      "step": 40,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#efebe5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding horizontal",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "── Header ──"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Lo que dicen nuestros clientes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "placeholder": "Experiencias reales de personas reales"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Alineación header",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Espacio bajo el header",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño título",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso título",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color título",
      "default": "#3e2563"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Título en mayúsculas",
      "default": false
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Margen inferior título",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamaño subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color subtítulo",
      "default": "#3e2563"
    },
    {
      "type": "header",
      "content": "── Reseñas y estrellas ──"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Mostrar resumen de calificación",
      "default": true,
      "info": "Promedio y conteo calculados a partir de las estrellas de cada reseña."
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Color estrellas",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Color estrellas vacías",
      "default": "#e2e2e2"
    },
    {
      "type": "header",
      "content": "── Carrusel ──"
    },
    {
      "type": "range",
      "id": "visible_cards",
      "label": "Tarjetas visibles (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "visible_cards_tablet",
      "label": "Tarjetas visibles (tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "visible_cards_mobile",
      "label": "Tarjetas visibles (móvil)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Ancho tarjeta móvil (%)",
      "min": 70,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Espacio entre tarjetas",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Duración transición",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "default": 350
    },
    {
      "type": "header",
      "content": "── Tarjeta ──"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Grosor borde",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color borde",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Padding cuerpo",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "── Imagen ──"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Fondo imagen",
      "default": "#f0f0f0"
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Ratio imagen (% altura/ancho)",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Foco imagen",
      "options": [
        {
          "value": "center center",
          "label": "Centro"
        },
        {
          "value": "top center",
          "label": "Arriba"
        },
        {
          "value": "bottom center",
          "label": "Abajo"
        },
        {
          "value": "center left",
          "label": "Izquierda"
        },
        {
          "value": "center right",
          "label": "Derecha"
        }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "── Texto de la reseña ──"
    },
    {
      "type": "range",
      "id": "review_text_size",
      "label": "Tamaño",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Color",
      "default": "#3e2563"
    },
    {
      "type": "range",
      "id": "review_text_lh",
      "label": "Altura de línea",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "range",
      "id": "text_margin_bottom",
      "label": "Margen inferior texto",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
