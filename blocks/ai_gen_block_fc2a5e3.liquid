{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-footer-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:56px 5% 24px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};font-family:{{ settings.type_body_font.family }}}.ai-footer-{{ ai_gen_id }}__main{display:grid;grid-template-columns:minmax(240px,1fr) 2fr;gap:64px;max-width:1280px;margin:0 auto}.ai-footer-{{ ai_gen_id }}__title{margin:0 0 18px;color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }};font-size:20px;line-height:1.2;letter-spacing:.04em}.ai-footer-{{ ai_gen_id }}__intro{margin:0 0 24px}.ai-footer-{{ ai_gen_id }}__form{display:flex;gap:8px;margin-bottom:28px}.ai-footer-{{ ai_gen_id }}__input{min-width:0;flex:1;padding:13px 14px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.input_radius }}px;background:{{ block.settings.input_background }};color:{{ block.settings.input_text_color }};font:inherit}.ai-footer-{{ ai_gen_id }}__button{padding:13px 18px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font:inherit;font-weight:700;cursor:pointer}.ai-footer-{{ ai_gen_id }}__link,.ai-footer-{{ ai_gen_id }}__social{color:{{ block.settings.link_color }};text-decoration:none}.ai-footer-{{ ai_gen_id }}__link:hover,.ai-footer-{{ ai_gen_id }}__social:hover{text-decoration:underline}.ai-footer-{{ ai_gen_id }}__socials{display:flex;gap:14px;flex-wrap:wrap}.ai-footer-{{ ai_gen_id }}__nav{display:grid;grid-template-columns:repeat(2,minmax(150px,1fr));gap:40px}.ai-footer-{{ ai_gen_id }}__list{display:grid;gap:12px;margin:0;padding:0;list-style:none}.ai-footer-{{ ai_gen_id }}__legal{max-width:1280px;margin:48px auto 0;padding-top:20px;border-top:1px solid {{ block.settings.border_color }}}.ai-footer-{{ ai_gen_id }}__copyright{margin:0 0 20px;color:{{ block.settings.muted_color }};font-size:12px;line-height:1.6}.ai-footer-{{ ai_gen_id }}__policies{display:flex;flex-wrap:wrap;gap:12px 24px}.ai-footer-{{ ai_gen_id }}__policies .ai-footer-{{ ai_gen_id }}__link{font-size:13px}.ai-footer-{{ ai_gen_id }}__input:focus-visible,.ai-footer-{{ ai_gen_id }}__button:focus-visible,.ai-footer-{{ ai_gen_id }}__link:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}@media(max-width:749px){.ai-footer-{{ ai_gen_id }}{padding:40px 20px 20px}.ai-footer-{{ ai_gen_id }}__main,.ai-footer-{{ ai_gen_id }}__nav{grid-template-columns:1fr;gap:36px}.ai-footer-{{ ai_gen_id }}__form{flex-direction:column}}
{% endstyle %}
<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-footer-{{ ai_gen_id }}__main"><div><h2 class="ai-footer-{{ ai_gen_id }}__title">{{ block.settings.signup_heading }}</h2><p class="ai-footer-{{ ai_gen_id }}__intro">{{ block.settings.signup_intro }}</p>{% form 'customer' %}<div class="ai-footer-{{ ai_gen_id }}__form"><input type="hidden" name="contact[tags]" value="newsletter"><label for="ai-footer-email-{{ ai_gen_id }}" class="visually-hidden">{{ block.settings.email_label }}</label><input id="ai-footer-email-{{ ai_gen_id }}" class="ai-footer-{{ ai_gen_id }}__input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ block.settings.email_placeholder }}" required><button class="ai-footer-{{ ai_gen_id }}__button" type="submit">{{ block.settings.subscribe_label }}</button></div>{% if form.posted_successfully? %}<p>{{ block.settings.success_message }}</p>{% endif %}{% endform %}<h2 class="ai-footer-{{ ai_gen_id }}__title">{{ block.settings.story_heading }}</h2><div class="ai-footer-{{ ai_gen_id }}__socials">{% if block.settings.instagram_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social" href="{{ block.settings.instagram_url }}">Instagram</a>{% endif %}{% if block.settings.facebook_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social" href="{{ block.settings.facebook_url }}">Facebook</a>{% endif %}{% if block.settings.tiktok_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social" href="{{ block.settings.tiktok_url }}">TikTok</a>{% endif %}</div></div><nav class="ai-footer-{{ ai_gen_id }}__nav" aria-label="Footer navigation"><div><h2 class="ai-footer-{{ ai_gen_id }}__title">FROM THE ROOTS</h2><ul class="ai-footer-{{ ai_gen_id }}__list"><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.story_url }}">Our Story</a></li><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.products_url }}">Products</a></li><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.contact_url }}">Contact us</a></li></ul></div><div><h2 class="ai-footer-{{ ai_gen_id }}__title">FUEL YOUR CURIOSITY</h2><ul class="ai-footer-{{ ai_gen_id }}__list"><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.recipes_url }}">Recipes</a></li><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.blog_url }}">Blog</a></li><li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.faq_url }}">FAQ</a></li></ul></div></nav></div><div class="ai-footer-{{ ai_gen_id }}__legal"><p class="ai-footer-{{ ai_gen_id }}__copyright">{{ block.settings.copyright }}</p><nav class="ai-footer-{{ ai_gen_id }}__policies" aria-label="Legal links"><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.accessibility_url }}">Accessibility Statement</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.terms_url }}">Terms &amp; Conditions</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.cookie_url }}">Cookie Policy</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.shipping_url }}">Shipping Policy</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.returns_url }}">Return Policy</a></nav></div></footer>
{% schema %}{"name":"Footer newsletter","settings":[{"type":"text","id":"signup_heading","label":"Heading","default":"Get the Scoop"},{"type":"text","id":"signup_intro","label":"Intro","default":"Be part of our story"},{"type":"text","id":"email_label","label":"Email label","default":"Email"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Email"},{"type":"text","id":"subscribe_label","label":"Button label","default":"Subscribe"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks for subscribing."},{"type":"text","id":"story_heading","label":"Social heading","default":"Be part of our story"},{"type":"url","id":"instagram_url","label":"Instagram"},{"type":"url","id":"facebook_url","label":"Facebook"},{"type":"url","id":"tiktok_url","label":"TikTok"},{"type":"url","id":"story_url","label":"Our Story"},{"type":"url","id":"products_url","label":"Products"},{"type":"url","id":"contact_url","label":"Contact us"},{"type":"url","id":"recipes_url","label":"Recipes"},{"type":"url","id":"blog_url","label":"Blog"},{"type":"url","id":"faq_url","label":"FAQ"},{"type":"textarea","id":"copyright","label":"Copyright","default":"© 2026 PRONTO CHOCHO. PRONTO CHOCHO™ is a registered trademark of Andean Pacha, LLC. All rights reserved."},{"type":"url","id":"accessibility_url","label":"Accessibility"},{"type":"url","id":"terms_url","label":"Terms"},{"type":"url","id":"cookie_url","label":"Cookie policy"},{"type":"url","id":"shipping_url","label":"Shipping policy"},{"type":"url","id":"returns_url","label":"Return policy"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"input_radius","label":"Input radius","min":0,"max":30,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":30,"step":2,"unit":"px","default":0},{"type":"color","id":"background_color","label":"Background","default":"#3e2563"},{"type":"color","id":"heading_color","label":"Headings","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"link_color","label":"Links","default":"#ffffff"},{"type":"color","id":"muted_color","label":"Muted text","default":"#e2c8f3"},{"type":"color","id":"border_color","label":"Borders","default":"#e2c8f3"},{"type":"color","id":"input_background","label":"Input background","default":"#ffffff"},{"type":"color","id":"input_text_color","label":"Input text","default":"#3e2563"},{"type":"color","id":"button_background","label":"Button background","default":"#ff4315"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#fedd94"}],"presets":[{"name":"Footer newsletter"}],"tag":null,"class":"footer-newsletter-block"}{% endschema %}