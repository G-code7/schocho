{%- liquid
  assign bid = block.id
  # Fuente del blog: el handle manual tiene prioridad sobre el selector
  assign blog_source = 'picker'
  assign blog = block.settings.blog
  assign blog_handle_input = block.settings.blog_handle | strip | handleize
  if blog_handle_input != blank
    assign blog_by_handle = blogs[blog_handle_input]
    if blog_by_handle.handle != blank
      assign blog = blog_by_handle
      assign blog_source = 'handle'
    else
      assign blog_source = 'handle-not-found'
    endif
  endif
  assign max_articles = block.settings.articles_limit | default: 5
  assign layout = block.settings.layout | default: 'split'

  # Si estamos dentro de un artículo, no lo repetimos en el slider
  assign skip_id = 0
  if template.name == 'article' and article
    assign skip_id = article.id
  endif

  # Pedimos uno extra por si hay que saltar el artículo actual
  assign fetch_limit = max_articles | plus: 1

  # Conteo real de slides (necesario para contador y dots)
  assign total = 0
  if blog != blank
    for post in blog.articles limit: fetch_limit
      if post.id == skip_id
        continue
      endif
      if total >= max_articles
        break
      endif
      assign total = total | plus: 1
    endfor
  endif

  # Slides visibles por vista
  if layout == 'split'
    assign per_view = 1
    assign per_view_tablet = 1
    assign per_view_mobile = 1
  else
    assign per_view = block.settings.cards_per_view | default: 3
    assign per_view_tablet = 2
    if per_view < 2
      assign per_view_tablet = per_view
    endif
    assign per_view_mobile = block.settings.cards_per_view_mobile | default: 1.15
  endif

  assign arrows_pos = block.settings.arrows_position | default: 'sides'
  assign arrows_mobile = block.settings.arrows_mobile | default: 'below'
  assign has_nav = false
  if total > per_view and block.settings.show_controls
    assign has_nav = true
  endif

  assign autoplay_ms = block.settings.autoplay_seconds | default: 6 | times: 1000
-%}

{%- style -%}
  #bs-{{ bid }} {
    --bs-bg: {{ block.settings.background_color }};
    --bs-card: {{ block.settings.content_background_color }};
    --bs-fg: {{ block.settings.text_color }};
    --bs-accent: {{ block.settings.accent_color }};
    --bs-border: {{ block.settings.border_color }};
    --bs-eyebrow: {{ block.settings.eyebrow_color }};
    --bs-img-bg: {{ block.settings.image_background }};
    --bs-gap: {{ block.settings.slide_gap }}px;
    --bs-per: {{ per_view }};
    --bs-radius: {{ block.settings.radius }}px;
    --bs-ease: cubic-bezier(0.83, 0, 0.17, 1);

    background-color: var(--bs-bg);
    color: var(--bs-fg);
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  #bs-{{ bid }} .bs__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  /* ── Header ─────────────────────────────── */
  #bs-{{ bid }} .bs__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }
  #bs-{{ bid }} .bs__header-text { text-align: {{ block.settings.header_alignment }}; flex: 1; }
  #bs-{{ bid }} .bs__eyebrow {
    display: block; font-size: 11px; font-weight: 500;
    letter-spacing: .15em; text-transform: uppercase;
    color: var(--bs-eyebrow); margin-bottom: 12px;
  }
  #bs-{{ bid }} .bs__section-title {
    font-size: {{ block.settings.title_size }}px; line-height: 1.1; font-weight: 400; margin: 0; color: var(--bs-fg);
  }
  #bs-{{ bid }} .bs__view-all {
    font-size: 14px; color: var(--bs-fg); text-decoration: none; white-space: nowrap;
    border-bottom: 1px solid var(--bs-border); padding-bottom: 2px; transition: border-color .3s ease;
  }
  #bs-{{ bid }} .bs__view-all:hover { border-color: var(--bs-fg); }

  /* ── Track (scroll-snap nativo: swipe real, sin librerías) ── */
  #bs-{{ bid }} .bs__track {
    display: flex;
    gap: var(--bs-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    flex-wrap: nowrap !important;
  }
  #bs-{{ bid }} .bs__track::-webkit-scrollbar { display: none; }
  #bs-{{ bid }} .bs__track:focus-visible { outline: 2px solid var(--bs-accent); outline-offset: 4px; }

  #bs-{{ bid }} .bs__slide {
    flex: 0 0 calc((100% - (var(--bs-per) - 1) * var(--bs-gap)) / var(--bs-per));
    min-width: 0;
    max-width: none;
    margin: 0 !important;
    padding: 0 !important;
    scroll-snap-align: start;
  }
  #bs-{{ bid }} .bs__slide::before,
  #bs-{{ bid }} .bs__slide::marker { content: none; }

  /* ── Tarjeta ────────────────────────────── */
  #bs-{{ bid }} .bs__card {
    position: relative;
    height: 100%;
    display: grid;
    border-radius: var(--bs-radius);
    overflow: hidden;
    background: var(--bs-card);
  }
  #bs-{{ bid }} .bs__card--split {
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    {%- if block.settings.split_gap > 0 %}
    gap: {{ block.settings.split_gap }}px;
    background: transparent;
    overflow: visible;
    {%- endif %}
  }
  #bs-{{ bid }} .bs__card--cards { grid-template-rows: auto 1fr; }

  #bs-{{ bid }} .bs__media {
    position: relative;
    overflow: hidden;
    background: var(--bs-img-bg);
    aspect-ratio: {{ block.settings.image_ratio }};
    {%- if block.settings.split_gap > 0 and layout == 'split' %} border-radius: var(--bs-radius);{% endif %}
  }
  #bs-{{ bid }} .bs__card--split .bs__media {
    order: {% if block.settings.image_position == 'left' %}-1{% else %}2{% endif %};
  }
  #bs-{{ bid }} .bs__media img,
  #bs-{{ bid }} .bs__media .bs__ph {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .8s var(--bs-ease);
  }
  #bs-{{ bid }} .bs__ph { display: flex; align-items: center; justify-content: center; }
  #bs-{{ bid }} .bs__ph svg { width: 40%; height: 40%; max-width: 150px; opacity: .3; }
  #bs-{{ bid }} .bs__card:hover .bs__media img { transform: scale(1.04); }

  #bs-{{ bid }} .bs__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ block.settings.content_spacing }}px;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    align-items: {% case block.settings.text_alignment %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
    background: var(--bs-card);
    {%- if block.settings.split_gap > 0 and layout == 'split' %} border-radius: var(--bs-radius);{% endif %}
  }
  #bs-{{ bid }} .bs__card--cards .bs__content {
    justify-content: flex-start;
    padding: {{ block.settings.content_padding | times: 0.55 | round }}px;
  }

  #bs-{{ bid }} .bs__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px;
    font-size: 11px; font-weight: 500; letter-spacing: .15em; text-transform: uppercase;
    color: var(--bs-eyebrow);
  }
  #bs-{{ bid }} .bs__meta-sep { opacity: .5; }

  #bs-{{ bid }} .bs__title {
    font-size: {{ block.settings.article_title_size }}px; line-height: 1.2; font-weight: 400; margin: 0; color: var(--bs-fg);
  }
  #bs-{{ bid }} .bs__card--cards .bs__title { font-size: {{ block.settings.article_title_size | times: 0.72 | round }}px; }
  #bs-{{ bid }} .bs__title a { color: inherit; text-decoration: none; }
  /* Toda la tarjeta es clicable sin anidar enlaces */
  #bs-{{ bid }} .bs__title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }

  #bs-{{ bid }} .bs__excerpt {
    font-size: {{ block.settings.description_size }}px; line-height: 1.7; opacity: .8; margin: 0;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: {{ block.settings.excerpt_lines }}; overflow: hidden;
  }

  /* ── Botón flecha animada ── */
  #bs-{{ bid }} .bs__foot { display: flex; align-items: center; gap: 16px; margin-top: auto; padding-top: 8px; }
  #bs-{{ bid }} .bs__card--split .bs__foot { margin-top: 8px; }
  #bs-{{ bid }} .bs__arrow-btn { position: relative; width: 64px; height: 32px; overflow: hidden; flex-shrink: 0; }
  #bs-{{ bid }} .bs__arrow-btn svg { position: absolute; }
  #bs-{{ bid }} .bs__pill { inset: 0; width: 100%; height: 100%; }
  #bs-{{ bid }} .bs__pill-bg { fill: none; stroke: var(--bs-border); stroke-width: 1; }
  #bs-{{ bid }} .bs__pill-fill {
    fill: none; stroke: var(--bs-accent); stroke-width: 1.5;
    stroke-dasharray: 118; stroke-dashoffset: 118; transition: stroke-dashoffset .6s var(--bs-ease);
  }
  #bs-{{ bid }} .bs__arr { top: 50%; left: 50%; color: var(--bs-fg); transition: transform .4s var(--bs-ease), opacity .4s ease; }
  #bs-{{ bid }} .bs__arr--1 { transform: translate(-50%, -50%); }
  #bs-{{ bid }} .bs__arr--2 { transform: translate(-150%, -50%); opacity: 0; }
  #bs-{{ bid }} .bs__card:hover .bs__pill-fill { stroke-dashoffset: 0; }
  #bs-{{ bid }} .bs__card:hover .bs__arr--1 { transform: translate(50%, -50%); opacity: 0; }
  #bs-{{ bid }} .bs__card:hover .bs__arr--2 { transform: translate(-50%, -50%); opacity: 1; }
  #bs-{{ bid }} .bs__read-time { font-size: 13px; opacity: .7; }

  /* ── Controles ─────────────────────────── */
  #bs-{{ bid }} .bs__controls {
    display: flex; align-items: center; gap: 20px;
    justify-content: {{ block.settings.controls_alignment }};
    margin-top: {{ block.settings.controls_spacing }}px;
  }
  #bs-{{ bid }} {
    --bs-arrow-size: {{ block.settings.arrow_size }}px;
    --bs-arrow-color: {{ block.settings.arrow_color }};
    --bs-arrow-bg: {{ block.settings.arrow_bg }};
    --bs-arrow-border: {{ block.settings.arrow_border }};
    --bs-arrow-color-hover: {{ block.settings.arrow_color_hover }};
    --bs-arrow-bg-hover: {{ block.settings.arrow_bg_hover }};
    --bs-arrow-offset: {{ block.settings.arrows_offset }}px;
    --bs-dot: {{ block.settings.dot_color }};
    --bs-dot-active: {{ block.settings.dot_active_color }};
  }

  #bs-{{ bid }} .bs__viewport { position: relative; }

  #bs-{{ bid }} .bs__nav { display: flex; gap: 12px; }
  #bs-{{ bid }} .bs__nav-btn {
    width: var(--bs-arrow-size); height: var(--bs-arrow-size); padding: 0; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--bs-arrow-bg); color: var(--bs-arrow-color); border: 1px solid var(--bs-arrow-border);
    cursor: pointer;
    {%- if block.settings.arrow_shadow %} box-shadow: 0 6px 20px -6px rgba(0,0,0,.25);{% endif %}
    transition: background-color .3s var(--bs-ease), color .3s var(--bs-ease), border-color .3s var(--bs-ease), opacity .3s ease, transform .3s var(--bs-ease);
  }
  #bs-{{ bid }} .bs__nav-btn svg { width: 42%; height: 42%; }
  #bs-{{ bid }} .bs__nav-btn:hover:not(:disabled) {
    background: var(--bs-arrow-bg-hover); color: var(--bs-arrow-color-hover); border-color: var(--bs-arrow-bg-hover);
  }
  #bs-{{ bid }} .bs__nav-btn:focus-visible { outline: 2px solid var(--bs-accent); outline-offset: 3px; }
  #bs-{{ bid }} .bs__nav-btn:disabled { opacity: .3; cursor: default; }

  /* Flechas a los lados, centradas verticalmente sobre el slider */
  #bs-{{ bid }} .bs__nav--sides { display: contents; }
  #bs-{{ bid }} .bs__nav--sides .bs__nav-btn {
    position: absolute;
    top: {% if layout == 'cards' and block.settings.arrows_center_on == 'image' %}calc(var(--bs-media-h, 50%) / 2){% else %}50%{% endif %};
    z-index: 3;
    transform: translateY(-50%);
  }
  #bs-{{ bid }} .bs__nav--sides [data-prev] { left: var(--bs-arrow-offset); }
  #bs-{{ bid }} .bs__nav--sides [data-next] { right: var(--bs-arrow-offset); }
  #bs-{{ bid }} .bs__nav--sides .bs__nav-btn:hover:not(:disabled) { transform: translateY(-50%) scale(1.06); }
  #bs-{{ bid }} .bs__nav--sides .bs__nav-btn:disabled {
    {%- if block.settings.hide_disabled_arrows %} opacity: 0; pointer-events: none;{% endif %}
  }
  #bs-{{ bid }} .bs__nav--below-mobile { display: none; }
  #bs-{{ bid }} .bs__dots { display: flex; gap: 4px; align-items: center; }
  #bs-{{ bid }} .bs__dot {
    width: 20px; height: 20px; padding: 0; border: 0; background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  #bs-{{ bid }} .bs__dot::before {
    content: ''; width: 6px; height: 6px; border-radius: 6px; background: var(--bs-dot);
    transition: width .35s var(--bs-ease), background-color .3s ease;
  }
  #bs-{{ bid }} .bs__dot:hover::before { background: var(--bs-dot-active); opacity: .6; }
  #bs-{{ bid }} .bs__dot.is-active::before { width: 20px; background: var(--bs-dot-active); opacity: 1; }
  #bs-{{ bid }} .bs__dot[hidden] { display: none; }
  #bs-{{ bid }} .bs__counter { font-size: 13px; font-weight: 500; letter-spacing: .05em; font-variant-numeric: tabular-nums; }
  #bs-{{ bid }} .bs__counter-total { opacity: .5; }

  #bs-{{ bid }} .bs__empty {
    text-align: center; padding: 80px 40px; font-size: 16px; background: var(--bs-card); border-radius: var(--bs-radius); opacity: .8;
  }

  /* ── Responsive ────────────────────────── */
  @media screen and (max-width: 990px) {
    #bs-{{ bid }} { --bs-per: {{ per_view_tablet }}; }
    #bs-{{ bid }} .bs__card--split { grid-template-columns: 1fr; gap: 0; }
    #bs-{{ bid }} .bs__card--split .bs__media { order: -1; aspect-ratio: 4 / 3; border-radius: 0; }
    #bs-{{ bid }} .bs__card--split .bs__content { border-radius: 0; padding: {{ block.settings.content_padding | times: 0.7 | round }}px; }
    #bs-{{ bid }} .bs__card--split { background: var(--bs-card); overflow: hidden; }
    #bs-{{ bid }} .bs__title { font-size: {{ block.settings.article_title_size | times: 0.85 | round }}px; }
  }

  @media screen and (max-width: 749px) {
    #bs-{{ bid }} {
      --bs-per: {{ per_view_mobile }};
      --bs-gap: {{ block.settings.slide_gap | at_most: 16 }}px;
      padding: {{ block.settings.padding_top | times: 0.6 | round }}px 0 {{ block.settings.padding_bottom | times: 0.6 | round }}px;
    }
    #bs-{{ bid }} .bs__container { padding: 0 20px; }
    #bs-{{ bid }} .bs__header { flex-direction: column; align-items: stretch; gap: 12px; margin-bottom: {{ block.settings.header_spacing | times: 0.7 | round }}px; }
    #bs-{{ bid }} .bs__section-title { font-size: {{ block.settings.title_size | times: 0.75 | round }}px; }
    #bs-{{ bid }} .bs__card--split .bs__content,
    #bs-{{ bid }} .bs__card--cards .bs__content { padding: 24px; }
    #bs-{{ bid }} .bs__title,
    #bs-{{ bid }} .bs__card--cards .bs__title { font-size: {{ block.settings.article_title_size | times: 0.7 | round }}px; }
    #bs-{{ bid }} .bs__excerpt { font-size: {{ block.settings.description_size | times: 0.9 | round }}px; }
    #bs-{{ bid }} .bs__controls { justify-content: center; }
    #bs-{{ bid }} .bs__nav-btn { width: calc(var(--bs-arrow-size) * .85); height: calc(var(--bs-arrow-size) * .85); }
    {%- if arrows_pos == 'sides' %}
      {%- if arrows_mobile == 'sides' %}
    #bs-{{ bid }} .bs__nav--sides [data-prev] { left: 8px; }
    #bs-{{ bid }} .bs__nav--sides [data-next] { right: 8px; }
      {%- else %}
    #bs-{{ bid }} .bs__nav--sides { display: none; }
        {%- if arrows_mobile == 'below' %}
    #bs-{{ bid }} .bs__nav--below-mobile { display: flex; }
        {%- endif %}
      {%- endif %}
    {%- elsif arrows_mobile == 'hide' %}
    #bs-{{ bid }} .bs__controls .bs__nav { display: none; }
    {%- endif %}
    #bs-{{ bid }} .bs__view-all { align-self: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    #bs-{{ bid }} .bs__track { scroll-behavior: auto; }
    #bs-{{ bid }} *, #bs-{{ bid }} *::before { transition: none !important; }
    #bs-{{ bid }} .bs__card:hover .bs__media img { transform: none; }
  }
{%- endstyle -%}

<div
  id="bs-{{ bid }}"
  class="bs"
  data-blog-slider
  data-loop="{{ block.settings.enable_loop }}"
  data-autoplay="{% if block.settings.autoplay and total > per_view %}{{ autoplay_ms }}{% else %}0{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="bs__container">
    {%- if block.settings.section_eyebrow != blank or block.settings.section_title != blank or block.settings.show_view_all -%}
      <div class="bs__header">
        <div class="bs__header-text">
          {%- if block.settings.section_eyebrow != blank -%}
            <span class="bs__eyebrow">{{ block.settings.section_eyebrow | escape }}</span>
          {%- endif -%}
          {%- if block.settings.section_title != blank -%}
            <h2 class="bs__section-title" id="bs-title-{{ bid }}">{{ block.settings.section_title | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if block.settings.show_view_all and blog != blank -%}
          <a href="{{ blog.url }}" class="bs__view-all">{{ block.settings.view_all_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if request.design_mode and block.settings.show_debug -%}
      <div style="font:12px/1.6 ui-monospace,Menlo,monospace;background:#1f2937;color:#e5e7eb;padding:14px 16px;border-radius:10px;margin-bottom:20px;text-align:left;">
        <strong style="color:#fbbf24;">Diagnóstico Blog Slider (solo visible en el editor)</strong><br>
        Fuente: {{ blog_source }}{% if blog_source == 'handle-not-found' %} → no existe un blog con handle "{{ blog_handle_input }}", se usa el selector{% endif %}<br>
        Blog: {% if blog != blank %}{{ blog.title }} (handle: <b>{{ blog.handle }}</b>){% else %}<span style="color:#f87171;">ninguno</span>{% endif %}<br>
        Artículos publicados en el blog: {{ blog.articles_count | default: 0 }}<br>
        Límite configurado: {{ max_articles }} · Renderizados: <b>{{ total }}</b><br>
        Estilo: {{ layout }} · Por vista desktop: {{ per_view }} · Controles: {% if total > per_view and block.settings.show_controls %}sí{% else %}no{% endif %}<br>
        {%- if skip_id != 0 %}Se omite el artículo actual (id {{ skip_id }})<br>{% endif -%}
        {%- if blog != blank %}
        Primeros artículos: {% for post in blog.articles limit: fetch_limit %}{{ post.handle }}{% unless forloop.last %}, {% endunless %}{% endfor %}<br>
        {%- endif %}
        Blogs de la tienda: {% for b in blogs %}{{ b.handle }} ({{ b.articles_count }}){% unless forloop.last %}, {% endunless %}{% endfor %}
      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      <div class="bs__viewport">
      <ul
        class="bs__track"
        data-track
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        {% if block.settings.section_title != blank %}aria-labelledby="bs-title-{{ bid }}"{% else %}aria-label="{{ blog.title | escape }}"{% endif %}
      >
        {%- assign rendered = 0 -%}
        {%- for post in blog.articles limit: fetch_limit -%}
          {%- if post.id == skip_id -%}{%- continue -%}{%- endif -%}
          {%- if rendered >= max_articles -%}{%- break -%}{%- endif -%}
          {%- assign rendered = rendered | plus: 1 -%}

          <li
            class="bs__slide"
            data-slide
            aria-roledescription="slide"
            aria-label="{{ rendered }} / {{ total }}"
          >
            <article class="bs__card bs__card--{{ layout }}">
              <div class="bs__media">
                {%- if post.image -%}
                  {%- liquid
                    assign img_alt = post.image.alt | default: post.title | escape
                    if layout == 'split'
                      assign img_sizes = '(max-width: 990px) 100vw, 50vw'
                    else
                      assign img_sizes = '(max-width: 749px) 90vw, (max-width: 990px) 50vw, 33vw'
                    endif
                    if rendered == 1
                      assign img_loading = 'eager'
                    else
                      assign img_loading = 'lazy'
                    endif
                  -%}
                  {{
                    post.image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200, 1400',
                      sizes: img_sizes,
                      loading: img_loading,
                      alt: img_alt
                  }}
                {%- else -%}
                  <div class="bs__ph">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>

              <div class="bs__content">
                {%- liquid
                  assign eyebrow = ''
                  if block.settings.show_eyebrow
                    if post.tags.size > 0
                      assign eyebrow = post.tags.first
                    elsif block.settings.custom_eyebrow != blank
                      assign eyebrow = block.settings.custom_eyebrow
                    endif
                  endif
                -%}
                {%- if eyebrow != blank or block.settings.show_date -%}
                  <div class="bs__meta">
                    {%- if eyebrow != blank -%}<span>{{ eyebrow | escape }}</span>{%- endif -%}
                    {%- if eyebrow != blank and block.settings.show_date -%}<span class="bs__meta-sep" aria-hidden="true">·</span>{%- endif -%}
                    {%- if block.settings.show_date -%}{{ post.published_at | time_tag: format: 'date' }}{%- endif -%}
                  </div>
                {%- endif -%}

                <h3 class="bs__title">
                  <a href="{{ post.url }}">{{ post.title | escape }}</a>
                </h3>

                {%- if block.settings.show_description -%}
                  {%- liquid
                    if post.excerpt != blank
                      assign excerpt = post.excerpt
                    else
                      assign excerpt = post.content
                    endif
                  -%}
                  <p class="bs__excerpt">{{ excerpt | strip_html | strip_newlines | truncate: block.settings.description_length }}</p>
                {%- endif -%}

                {%- if block.settings.show_button or block.settings.show_read_time -%}
                  <div class="bs__foot">
                    {%- if block.settings.show_button -%}
                      <span class="bs__arrow-btn" aria-hidden="true">
                        <svg class="bs__pill" width="64" height="32" viewBox="0 0 64 32" fill="none">
                          <path class="bs__pill-bg" d="M16 1h32a15 15 0 0 1 0 30H16a15 15 0 0 1 0-30z"/>
                          <path class="bs__pill-fill" d="M16 1h32a15 15 0 0 1 0 30H16a15 15 0 0 1 0-30z"/>
                        </svg>
                        <svg class="bs__arr bs__arr--1" width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5h10M11 5 6.7 1M11 5 6.7 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/></svg>
                        <svg class="bs__arr bs__arr--2" width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5h10M11 5 6.7 1M11 5 6.7 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/></svg>
                      </span>
                    {%- endif -%}
                    {%- if block.settings.show_read_time -%}
                      {%- assign words = post.content | strip_html | split: ' ' | size -%}
                      {%- assign read_time = words | divided_by: 200 | at_least: 1 -%}
                      <span class="bs__read-time">{{ read_time }} {{ block.settings.read_time_label | escape }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>

        {%- if has_nav and block.settings.show_arrows and arrows_pos == 'sides' -%}
            <div class="bs__nav bs__nav--sides">
              <button type="button" class="bs__nav-btn" data-prev aria-label="Artículo anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" class="bs__nav-btn" data-next aria-label="Artículo siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
        {%- endif -%}
      </div>

      {%- liquid
        assign show_controls_row = false
        if has_nav
          if block.settings.show_dots or block.settings.show_counter
            assign show_controls_row = true
          endif
          if block.settings.show_arrows and arrows_pos == 'below'
            assign show_controls_row = true
          endif
          if block.settings.show_arrows and arrows_pos == 'sides' and arrows_mobile == 'below'
            assign show_controls_row = true
          endif
        endif
      -%}
      {%- if show_controls_row -%}
        <div class="bs__controls">
          {%- if block.settings.show_arrows and arrows_pos == 'below' -%}
            <div class="bs__nav">
              <button type="button" class="bs__nav-btn" data-prev aria-label="Artículo anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" class="bs__nav-btn" data-next aria-label="Artículo siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          {%- elsif block.settings.show_arrows and arrows_pos == 'sides' and arrows_mobile == 'below' -%}
            <div class="bs__nav bs__nav--below-mobile">
              <button type="button" class="bs__nav-btn" data-prev aria-label="Artículo anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" class="bs__nav-btn" data-next aria-label="Artículo siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          {%- endif -%}

          {%- if block.settings.show_counter -%}
            <div class="bs__counter" aria-live="polite">
              <span data-current>01</span><span class="bs__counter-total"> / {{ total | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- endif -%}

          {%- if block.settings.show_dots -%}
            <div class="bs__dots">
              {%- for i in (1..total) -%}
                <button
                  type="button"
                  class="bs__dot{% if forloop.first %} is-active{% endif %}"
                  data-dot="{{ forloop.index0 }}"
                  aria-label="Ir al artículo {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="bs__empty">
        <p>{{ block.settings.empty_message | escape }}</p>
        {%- if blog == blank and request.design_mode -%}
          <p style="margin-top:10px;font-size:14px;">Selecciona un blog en la configuración del bloque.</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initBlogSlider(root) {
      if (!root || root.dataset.bsReady) return;
      const track = root.querySelector('[data-track]');
      if (!track) return;
      const slides = Array.from(track.querySelectorAll('[data-slide]'));
      if (slides.length < 2) return;
      root.dataset.bsReady = '1';

      const prevs = Array.from(root.querySelectorAll('[data-prev]'));
      const nexts = Array.from(root.querySelectorAll('[data-next]'));
      const dots = Array.from(root.querySelectorAll('[data-dot]'));
      const current = root.querySelector('[data-current]');
      const loop = root.dataset.loop === 'true';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplayMs = reduced ? 0 : parseInt(root.dataset.autoplay, 10) || 0;
      const isEditor = !!(window.Shopify && window.Shopify.designMode);

      /* Índice del último slide al que se puede llegar (según slides por vista) */
      function maxIndex() {
        const w = slides[0].getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const perView = Math.max(1, Math.round((track.clientWidth + gap) / (w + gap)));
        return Math.max(0, slides.length - perView);
      }

      function slideLeft(s) {
        return s.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
      }

      function activeIndex() {
        const left = track.scrollLeft;
        let best = 0, bestDist = Infinity;
        slides.forEach((s, i) => {
          const d = Math.abs(slideLeft(s) - left);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        if (left >= track.scrollWidth - track.clientWidth - 2) return maxIndex();
        return Math.min(best, maxIndex());
      }

      function goTo(i) {
        const max = maxIndex();
        if (loop) {
          if (i > max) i = 0;
          if (i < 0) i = max;
        } else {
          i = Math.max(0, Math.min(i, max));
        }
        track.scrollTo({ left: slideLeft(slides[i]), behavior: reduced ? 'auto' : 'smooth' });
      }

      function update() {
        const i = activeIndex();
        const max = maxIndex();
        dots.forEach((d, idx) => {
          d.hidden = idx > max;
          const on = idx === i;
          d.classList.toggle('is-active', on);
          d.setAttribute('aria-current', on ? 'true' : 'false');
        });
        if (current) current.textContent = String(i + 1).padStart(2, '0');
        if (!loop) {
          prevs.forEach((b) => (b.disabled = i <= 0));
          nexts.forEach((b) => (b.disabled = i >= max));
        }
      }

      prevs.forEach((b) => b.addEventListener('click', () => { stop(); goTo(activeIndex() - 1); }));
      nexts.forEach((b) => b.addEventListener('click', () => { stop(); goTo(activeIndex() + 1); }));

      /* En estilo cards, las flechas se centran sobre la imagen */
      const firstMedia = track.querySelector('.bs__card--cards .bs__media');
      function syncArrowTop() {
        if (firstMedia) root.style.setProperty('--bs-media-h', firstMedia.getBoundingClientRect().height + 'px');
      }
      syncArrowTop();
      window.addEventListener('resize', syncArrowTop, { passive: true });
      dots.forEach((d) => d.addEventListener('click', () => { stop(); goTo(parseInt(d.dataset.dot, 10)); }));

      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); stop(); goTo(activeIndex() + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); stop(); goTo(activeIndex() - 1); }
      });

      let raf;
      track.addEventListener('scroll', () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });

      /* Autoplay: se pausa con hover, foco, toque, pestaña oculta o fuera de pantalla */
      let timer = null, inView = true, userStopped = false;
      function start() {
        if (!autoplayMs || isEditor || userStopped || !inView || document.hidden) return;
        clearInterval(timer);
        timer = setInterval(() => goTo(activeIndex() + 1), autoplayMs);
      }
      function pause() { clearInterval(timer); timer = null; }
      function stop() { userStopped = true; pause(); }

      if (autoplayMs) {
        root.addEventListener('mouseenter', pause);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', pause);
        root.addEventListener('focusout', start);
        track.addEventListener('touchstart', stop, { passive: true });
        document.addEventListener('visibilitychange', () => (document.hidden ? pause() : start()));
        if ('IntersectionObserver' in window) {
          new IntersectionObserver((entries) => {
            inView = entries[0].isIntersecting;
            inView ? start() : pause();
          }, { threshold: 0.25 }).observe(root);
        }
      }

      update();
      start();
    }

    initBlogSlider(document.getElementById('bs-{{ bid }}'));
    document.addEventListener('shopify:section:load', () => initBlogSlider(document.getElementById('bs-{{ bid }}')));
  })();
</script>

{% schema %}
{
  "name": "Blog Slider",
  "settings": [
    { "type": "header", "content": "Blog" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "text",
      "id": "blog_handle",
      "label": "Blog handle (optional)",
      "placeholder": "news",
      "info": "Overrides the picker. Find it in the blog URL: /blogs/HANDLE. Use it to lock this slider to the 'Blog' and never to 'Recipes'."
    },
    {
      "type": "range",
      "id": "articles_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Latest articles to show",
      "default": 5,
      "info": "Newest published first. On an article page, the current article is skipped."
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "text", "id": "view_all_text", "label": "'View all' text", "default": "View all articles" },

    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "section_eyebrow", "label": "Eyebrow", "default": "FROM THE BLOG" },
    { "type": "text", "id": "section_title", "label": "Title", "default": "Insights & Stories" },
    { "type": "range", "id": "title_size", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Title size", "default": 36 },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "header_spacing", "min": 20, "max": 80, "step": 4, "unit": "px", "label": "Header bottom spacing", "default": 40 },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Slide style",
      "options": [
        { "value": "split", "label": "Featured (1 article: text + image)" },
        { "value": "cards", "label": "Cards (several per view)" }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards per view (desktop)",
      "default": 3,
      "info": "Cards style only."
    },
    {
      "type": "select",
      "id": "cards_per_view_mobile",
      "label": "Cards per view (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.15", "label": "1 + peek of next" },
        { "value": "1.6", "label": "1.5" }
      ],
      "default": "1.15",
      "info": "A peek of the next card tells users they can swipe."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (featured style)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "slide_gap", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Gap between slides", "default": 24 },
    { "type": "range", "id": "split_gap", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Gap between text and image (featured)", "default": 0 },
    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 16 },
    { "type": "range", "id": "content_padding", "min": 24, "max": 80, "step": 4, "unit": "px", "label": "Content padding", "default": 48 },
    { "type": "range", "id": "content_spacing", "min": 8, "max": 40, "step": 4, "unit": "px", "label": "Content inner spacing", "default": 20 },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Article content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show first tag", "default": true },
    { "type": "text", "id": "custom_eyebrow", "label": "Fallback eyebrow", "info": "Used when an article has no tags." },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": false },
    { "type": "range", "id": "article_title_size", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Article title size", "default": 28 },
    { "type": "checkbox", "id": "show_description", "label": "Show excerpt", "default": true },
    { "type": "range", "id": "description_length", "min": 80, "max": 400, "step": 10, "label": "Excerpt max characters", "default": 180 },
    { "type": "range", "id": "excerpt_lines", "min": 2, "max": 6, "step": 1, "label": "Excerpt max lines", "default": 4, "info": "Keeps every slide the same height." },
    { "type": "range", "id": "description_size", "min": 14, "max": 20, "step": 1, "unit": "px", "label": "Excerpt size", "default": 16 },
    { "type": "checkbox", "id": "show_button", "label": "Show arrow button", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "Show read time", "default": true },
    { "type": "text", "id": "read_time_label", "label": "Read time label", "default": "min read" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "content_background_color", "label": "Card background", "default": "#f5f3ef" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2c2416" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow / meta", "default": "#8b7355" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c4a574" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#e5e1da" },
    { "type": "color", "id": "image_background", "label": "Image placeholder background", "default": "#fff0bb" },

    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "Arrows position",
      "options": [
        { "value": "sides", "label": "Sides (over the slider)" },
        { "value": "below", "label": "Below, with dots" }
      ],
      "default": "sides"
    },
    {
      "type": "range",
      "id": "arrows_offset",
      "min": -40,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Side arrows offset",
      "default": 16,
      "info": "Positive = inside the slider. Negative = pushed outside the edges."
    },
    {
      "type": "select",
      "id": "arrows_center_on",
      "label": "Center side arrows on (cards style)",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "card", "label": "Whole card" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "arrows_mobile",
      "label": "Side arrows on mobile",
      "options": [
        { "value": "below", "label": "Move below, with dots" },
        { "value": "sides", "label": "Keep on the sides" },
        { "value": "hide", "label": "Hide (swipe only)" }
      ],
      "default": "below"
    },
    { "type": "checkbox", "id": "hide_disabled_arrows", "label": "Hide side arrow at start/end", "default": true, "info": "Only when loop is off." },
    { "type": "range", "id": "arrow_size", "min": 32, "max": 64, "step": 2, "unit": "px", "label": "Arrow size", "default": 48 },
    { "type": "checkbox", "id": "arrow_shadow", "label": "Arrow shadow", "default": true },
    { "type": "color", "id": "arrow_color", "label": "Arrow icon", "default": "#2c2416" },
    { "type": "color_background", "id": "arrow_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_border", "label": "Arrow border", "default": "#e5e1da" },
    { "type": "color", "id": "arrow_color_hover", "label": "Arrow icon (hover)", "default": "#ffffff" },
    { "type": "color", "id": "arrow_bg_hover", "label": "Arrow background (hover)", "default": "#2c2416" },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#d6cfc4" },
    { "type": "color", "id": "dot_active_color", "label": "Active dot color", "default": "#2c2416" },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "checkbox", "id": "show_counter", "label": "Show counter", "default": false },
    {
      "type": "select",
      "id": "controls_alignment",
      "label": "Controls alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "controls_spacing", "min": 20, "max": 60, "step": 4, "unit": "px", "label": "Controls top spacing", "default": 32 },

    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "enable_loop", "label": "Loop back to start", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false, "info": "Pauses on hover, touch and when off-screen. Disabled in the theme editor." },
    { "type": "range", "id": "autoplay_seconds", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Autoplay interval", "default": 6 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 },
    { "type": "range", "id": "horizontal_padding", "min": 16, "max": 60, "step": 4, "unit": "px", "label": "Horizontal padding", "default": 24 },

    { "type": "header", "content": "Debug" },
    { "type": "checkbox", "id": "show_debug", "label": "Show diagnostic panel (theme editor only)", "default": true },

    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_message", "label": "Empty message", "default": "No articles found" }
  ],
  "presets": [
    { "name": "Blog Slider", "category": "Blog" }
  ]
}
{% endschema %}
