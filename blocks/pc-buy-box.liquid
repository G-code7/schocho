{%- doc -%}
  Selector de compra en 2 pasos (sabor → plan).
  - En el PDP: va dentro de "Product information". Preselecciona el producto
    de la página; elegir otro sabor lleva a su página manteniendo el plan.
  - En la tienda / home: agrégalo a una sección "Section" (acepta bloques).
    Preselecciona el primer sabor de la lista y cambia en el mismo lugar.
  Lógica: snippets/pc-buy-box.liquid + assets/pc-buy-box.js.
{%- enddoc -%}
{%- liquid
  assign flavors = block.settings.flavors
  assign p = closest.product | default: product
  if block.settings.product != blank
    assign p = block.settings.product
  endif
  if p == blank and flavors.size > 0
    assign p = flavors.first
  endif

  # En el editor se cambia en el mismo lugar, para poder previsualizar cada sabor.
  assign navigate = false
  if template.name == 'product' and p.id == product.id and request.design_mode == false
    assign navigate = true
  endif

  capture style
    echo '--pc-accent:' | append: block.settings.accent | append: ';'
    echo '--pc-surface:' | append: block.settings.surface | append: ';'
    echo '--pc-surface-active:' | append: block.settings.surface_active | append: ';'
    echo '--pc-border:' | append: block.settings.border | append: ';'
    echo '--pc-btn:' | append: block.settings.button_bg | append: ';'
    echo '--pc-btn-text:' | append: block.settings.button_text | append: ';'
    echo '--pc-radius:' | append: block.settings.radius | append: 'px;'
  endcapture
-%}
{%- if p != blank -%}
  {%- render 'pc-buy-box',
    product: p,
    flavors: flavors,
    navigate: navigate,
    uid: block.id,
    attrs: block.shopify_attributes,
    default_option: block.settings.default_option,
    flavor_label: block.settings.flavor_label,
    plan_label: block.settings.plan_label,
    sub_title: block.settings.sub_title,
    sub_badge: block.settings.sub_badge,
    benefits: block.settings.benefits,
    onetime_title: block.settings.onetime_title,
    onetime_subtitle: block.settings.onetime_subtitle,
    onetime_codes: block.settings.onetime_codes,
    note_sub: block.settings.note_sub,
    note_onetime: block.settings.note_onetime,
    show_per_serving: block.settings.show_per_serving,
    servings: block.settings.servings,
    per_label: block.settings.per_label,
    show_quantity: block.settings.show_quantity,
    atc_text: block.settings.atc_text,
    show_dynamic_checkout: block.settings.show_dynamic_checkout,
    open_drawer: block.settings.open_drawer,
    sticky_mobile: block.settings.sticky_mobile,
    style: style
  -%}
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Selector de compra: elige los sabores en la configuración del bloque.</p>
{%- endif -%}

{% schema %}
{
  "name": "Selector de compra",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Paso 1: sabor" },
    {
      "type": "product_list",
      "id": "flavors",
      "label": "Sabores",
      "limit": 6,
      "info": "En este orden. Fuera de una página de producto queda preseleccionado el primero (PURE). Nombre corto: metafield custom.short_name."
    },
    { "type": "text", "id": "flavor_label", "label": "Título del paso 1", "default": "Choose your flavor" },
    {
      "type": "product",
      "id": "product",
      "label": "Producto fijo (opcional)",
      "info": "Solo si quieres forzar uno. Vacío = el de la página o el primer sabor."
    },
    { "type": "header", "content": "Paso 2: plan" },
    { "type": "text", "id": "plan_label", "label": "Título del paso 2", "default": "Choose your plan" },
    {
      "type": "select",
      "id": "default_option",
      "label": "Plan preseleccionado",
      "options": [
        { "value": "subscription", "label": "Subscribe & Save" },
        { "value": "onetime", "label": "Compra única" }
      ],
      "default": "subscription"
    },
    { "type": "text", "id": "sub_title", "label": "Título suscripción", "default": "Subscribe & Save" },
    {
      "type": "text",
      "id": "sub_badge",
      "label": "Etiqueta de ahorro",
      "default": "Save [percent]%",
      "info": "[percent] = ahorro real del plan. La frecuencia se toma del plan de la app de suscripciones."
    },
    {
      "type": "textarea",
      "id": "benefits",
      "label": "Beneficios de la suscripción",
      "default": "Cancel or skip anytime",
      "info": "Uno por línea. Solo beneficios reales."
    },
    { "type": "text", "id": "onetime_title", "label": "Título compra única", "default": "One-time purchase" },
    {
      "type": "text",
      "id": "onetime_subtitle",
      "label": "Subtítulo compra única",
      "info": "Ej.: \"15% off applied in cart\" si usas un código de compra única."
    },
    {
      "type": "text",
      "id": "onetime_codes",
      "label": "Códigos para compra única",
      "info": "Separados por coma. Se aplican al carrito y ocultan el pago rápido. Mejor: descuentos automáticos en Admin, que funcionan con Apple Pay."
    },
    { "type": "header", "content": "Envío y promos (una sola línea)" },
    {
      "type": "text",
      "id": "note_sub",
      "label": "Nota con suscripción",
      "info": "Se muestra bajo el botón solo con Subscribe & Save. Ej.: \"Free shipping on every delivery\"."
    },
    {
      "type": "text",
      "id": "note_onetime",
      "label": "Nota con compra única",
      "info": "Se muestra bajo el botón solo con compra única. Ej.: \"Free shipping on orders over $50\"."
    },
    { "type": "header", "content": "Precio por porción" },
    { "type": "checkbox", "id": "show_per_serving", "label": "Mostrar precio por porción", "default": true },
    {
      "type": "number",
      "id": "servings",
      "label": "Porciones por unidad",
      "default": 15,
      "info": "El metafield custom.servings de cada producto tiene prioridad."
    },
    { "type": "text", "id": "per_label", "label": "Texto por porción", "default": "serving" },
    { "type": "header", "content": "Compra" },
    { "type": "checkbox", "id": "show_quantity", "label": "Mostrar cantidad", "default": true },
    { "type": "text", "id": "atc_text", "label": "Texto del botón", "default": "Add to cart" },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Botones de pago rápido (compra única)",
      "default": false,
      "info": "Apagado por defecto: Apple Pay / Google Pay se saltan el carrito. Con códigos se ocultan siempre."
    },
    { "type": "checkbox", "id": "open_drawer", "label": "Abrir el carrito al agregar", "default": true },
    { "type": "checkbox", "id": "sticky_mobile", "label": "Botón fijo en móvil", "default": true },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "accent", "label": "Acento", "default": "#3e2563" },
    { "type": "color", "id": "surface", "label": "Fondo opción", "default": "#FFFCF8" },
    { "type": "color", "id": "surface_active", "label": "Fondo seleccionado", "default": "#FCF3EC" },
    { "type": "color", "id": "border", "label": "Borde", "default": "#E8E4DF" },
    { "type": "color", "id": "button_bg", "label": "Botón", "default": "#3e2563" },
    { "type": "color", "id": "button_text", "label": "Texto del botón", "default": "#ffffff" },
    { "type": "range", "id": "radius", "label": "Radio", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Selector de compra" }]
}
{% endschema %}
