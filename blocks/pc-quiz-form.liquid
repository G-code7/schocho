{% doc %}
  @name        PC Quiz Form — "Which Chocho fits your routine?"
  @description Quiz conversacional nativo (una pregunta por pantalla) para tráfico frío.
               3 preguntas -> gate de email -> resultado con el blend match + botón de compra
               con WELLNESS20 aplicado. Envía las respuestas + el match al webhook de Make.com
               (fetch directo, sin apps de terceros tipo Octane/Jebbit).

               Reparto de responsabilidades:
               - LANDING (este bloque): UI del quiz, scoring, gate de email, pantalla de resultado.
               - MAKE.com: recibe el webhook y suscribe a Klaviyo (private key server-side).
               - KLAVIYO: lista + flows. La propiedad `chocho_match` habilita el email
                 "tu match + recetas" a futuro.

  @usage       Colócalo dentro de una sección en el template de la landing (page.quiz-*.json).

  ── EDITAR COPY DE CAMPAÑA ──
  Las 3 preguntas y sus respuestas están en los arrays Liquid de abajo (assign q1_*, q2_*, q3_*).
  Cada respuesta de Q1 y Q2 lleva un blend en el sufijo (::pure / ::kalpa / ::root) que alimenta
  el scoring. Q3 es solo segmentación (no afecta el match). Para cambiar el copy, edita las labels
  antes del "::" — no toques el sufijo salvo que quieras recablear el scoring.
{% enddoc %}

{% assign pc_id = block.id | replace: '_', '' | downcase %}

{%- comment -%} ── Productos por match (pickers en el editor) ── {%- endcomment -%}
{%- assign p_pure  = block.settings.product_pure  -%}
{%- assign p_kalpa = block.settings.product_kalpa -%}
{%- assign p_root  = block.settings.product_root  -%}
{%- assign discount = block.settings.discount_code -%}

{%- comment -%} ── Preguntas y respuestas (formato: "Label::blend") ── {%- endcomment -%}
{%- assign q1_options = "Sweet — smoothies, oats, baking::kalpa,Savory — soups, sauces, golden milk::root,A bit of everything::pure" | split: "," -%}
{%- assign q2_options = "Steady energy::kalpa,Everyday wellness::root,Just keep it simple::pure" | split: "," -%}
{%- assign q3_options = "Just me,Me + my kids,The whole family" | split: "," -%}

{% style %}
  .pcq-{{ pc_id }} {
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin-inline: auto;
    padding: {{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;
    background-color: {{ block.settings.bg_color }};
    color: {{ block.settings.text_color }};
    box-sizing: border-box;
    font-family: inherit;
  }

  /* ── Progress ── */
  .pcq__progress-{{ pc_id }} {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
  }
  .pcq__progress-dot-{{ pc_id }} {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background-color: {{ block.settings.text_color }}26;
    transition: background-color 0.3s ease;
  }
  .pcq__progress-dot-{{ pc_id }}.is-done {
    background-color: {{ block.settings.btn_bg }};
  }

  /* ── Steps ── */
  .pcq__step-{{ pc_id }} {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .pcq__step-{{ pc_id }}.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .pcq__eyebrow-{{ pc_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 12px;
  }
  .pcq__heading-{{ pc_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0 0 24px;
  }
  .pcq__subtitle-{{ pc_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.6;
    opacity: 0.7;
    margin: -12px 0 24px;
  }

  /* ── Answer options ── */
  .pcq__options-{{ pc_id }} { display: flex; flex-direction: column; gap: 10px; }
  .pcq__option-{{ pc_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.1s ease;
    font-size: {{ block.settings.input_font_size }}px;
    line-height: 1.4;
  }
  .pcq__option-{{ pc_id }}:hover { border-color: {{ block.settings.btn_bg }}; background-color: {{ block.settings.btn_bg }}0d; }
  .pcq__option-{{ pc_id }}.is-selected { border-color: {{ block.settings.btn_bg }}; background-color: {{ block.settings.btn_bg }}1a; }
  .pcq__option-{{ pc_id }} input { position: absolute; opacity: 0; pointer-events: none; }
  .pcq__option-marker-{{ pc_id }} {
    width: 18px; height: 18px; flex-shrink: 0;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 50%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .pcq__option-{{ pc_id }}.is-selected .pcq__option-marker-{{ pc_id }} {
    border-color: {{ block.settings.btn_bg }};
    box-shadow: inset 0 0 0 4px {{ block.settings.btn_bg }};
  }

  /* ── Email gate ── */
  .pcq__field-{{ pc_id }} { margin-bottom: 20px; }
  .pcq__label-{{ pc_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .pcq__input-{{ pc_id }} {
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border: none;
    border-bottom: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: 0;
    font-family: inherit;
    font-size: {{ block.settings.input_font_size }}px;
    color: {{ block.settings.text_color }};
    padding: 12px 0;
    transition: border-color 0.2s ease;
    -webkit-appearance: none; appearance: none;
  }
  .pcq__input-{{ pc_id }}::placeholder { color: {{ block.settings.text_color }}; opacity: 0.35; font-style: italic; }
  .pcq__input-{{ pc_id }}:focus { outline: none; border-color: {{ block.settings.btn_bg }}; }

  .pcq__check-{{ pc_id }} { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 24px; }
  .pcq__check-{{ pc_id }} input { width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px; accent-color: {{ block.settings.btn_bg }}; cursor: pointer; }
  .pcq__check-{{ pc_id }} label { font-size: {{ block.settings.label_size }}px; opacity: 0.7; line-height: 1.5; cursor: pointer; }

  /* ── Buttons ── */
  .pcq__btn-{{ pc_id }} {
    width: 100%;
    padding: {{ block.settings.btn_padding_v }}px {{ block.settings.btn_padding_h }}px;
    background-color: {{ block.settings.btn_bg }};
    color: {{ block.settings.btn_text }};
    border: none;
    border-radius: {{ block.settings.btn_radius }}px;
    font-family: inherit;
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease, opacity 0.25s ease;
    text-align: center;
    text-decoration: none;
    display: inline-block;
  }
  .pcq__btn-{{ pc_id }}:hover:not(:disabled) { background-color: {{ block.settings.btn_hover_bg }}; }
  .pcq__btn-{{ pc_id }}:disabled { opacity: 0.5; cursor: not-allowed; }

  .pcq__back-{{ pc_id }} {
    background: none; border: none; cursor: pointer;
    font-family: inherit; font-size: {{ block.settings.label_size }}px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: {{ block.settings.text_color }}; opacity: 0.5;
    padding: 14px 0 0; transition: opacity 0.2s;
  }
  .pcq__back-{{ pc_id }}:hover { opacity: 1; }

  .pcq__feedback-{{ pc_id }} {
    font-size: {{ block.settings.label_size }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ block.settings.error_color }};
    margin-top: 14px;
    min-height: 1em;
    display: none;
  }
  .pcq__feedback-{{ pc_id }}.is-visible { display: block; }

  /* ── Result ── */
  .pcq__result-card-{{ pc_id }} { display: none; text-align: center; }
  .pcq__result-card-{{ pc_id }}.is-match { display: block; }
  .pcq__result-img-{{ pc_id }} {
    width: 100%; max-width: 280px; height: auto; margin: 0 auto 24px;
    border-radius: 12px; display: block;
  }
  .pcq__result-eyebrow-{{ pc_id }} {
    font-size: {{ block.settings.label_size }}px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.55; margin: 0 0 8px;
  }
  .pcq__result-name-{{ pc_id }} { font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.heading_weight }}; margin: 0 0 12px; letter-spacing: 0.02em; }
  .pcq__result-desc-{{ pc_id }} { font-size: {{ block.settings.subtitle_size }}px; line-height: 1.6; opacity: 0.75; margin: 0 auto 20px; max-width: 46ch; }
  .pcq__result-price-{{ pc_id }} { font-size: {{ block.settings.input_font_size }}px; margin: 0 0 8px; }
  .pcq__result-code-{{ pc_id }} {
    display: inline-block; margin: 0 0 24px; padding: 8px 16px;
    border: 1px dashed {{ block.settings.btn_bg }}; border-radius: 8px;
    font-size: {{ block.settings.label_size }}px; letter-spacing: 0.12em; text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .pcq-{{ pc_id }} { padding: {{ block.settings.padding_v | divided_by: 1.5 | round }}px {{ block.settings.padding_h | divided_by: 1.5 | round }}px; }
    .pcq__heading-{{ pc_id }}, .pcq__result-name-{{ pc_id }} { font-size: {{ block.settings.heading_size | times: 0.72 | round }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcq__step-{{ pc_id }} { transition: none; transform: none; }
  }
{% endstyle %}

<div class="pcq-{{ pc_id }}" {{ block.shopify_attributes }}>

  <div class="pcq__progress-{{ pc_id }}" aria-hidden="true">
    {%- for i in (1..4) -%}
      <span class="pcq__progress-dot-{{ pc_id }}" data-dot="{{ i }}"></span>
    {%- endfor -%}
  </div>

  <div class="pcq__steps-{{ pc_id }}" aria-live="polite">

    {%- comment -%} ── STEP 1 — Q1: recipe type ── {%- endcomment -%}
    <div class="pcq__step-{{ pc_id }} is-active" data-step="1" role="group">
      <p class="pcq__eyebrow-{{ pc_id }}">Question 1 of 3</p>
      <h2 class="pcq__heading-{{ pc_id }}">{{ block.settings.q1_heading }}</h2>
      <div class="pcq__options-{{ pc_id }}" role="radiogroup" aria-label="{{ block.settings.q1_heading | strip_html }}">
        {%- for opt in q1_options -%}
          {%- assign parts = opt | split: "::" -%}
          <label class="pcq__option-{{ pc_id }}">
            <input type="radio" name="pcq-q1-{{ pc_id }}" value="{{ parts[0] | strip }}" data-blend="{{ parts[1] | strip }}" data-advance="2">
            <span class="pcq__option-marker-{{ pc_id }}"></span>
            <span>{{ parts[0] | strip }}</span>
          </label>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ── STEP 2 — Q2: goal ── {%- endcomment -%}
    <div class="pcq__step-{{ pc_id }}" data-step="2" role="group">
      <p class="pcq__eyebrow-{{ pc_id }}">Question 2 of 3</p>
      <h2 class="pcq__heading-{{ pc_id }}">{{ block.settings.q2_heading }}</h2>
      <div class="pcq__options-{{ pc_id }}" role="radiogroup" aria-label="{{ block.settings.q2_heading | strip_html }}">
        {%- for opt in q2_options -%}
          {%- assign parts = opt | split: "::" -%}
          <label class="pcq__option-{{ pc_id }}">
            <input type="radio" name="pcq-q2-{{ pc_id }}" value="{{ parts[0] | strip }}" data-blend="{{ parts[1] | strip }}" data-advance="3">
            <span class="pcq__option-marker-{{ pc_id }}"></span>
            <span>{{ parts[0] | strip }}</span>
          </label>
        {%- endfor -%}
      </div>
      <button type="button" class="pcq__back-{{ pc_id }}" data-back="1">← Back</button>
    </div>

    {%- comment -%} ── STEP 3 — Q3: who for (segmentation only) ── {%- endcomment -%}
    <div class="pcq__step-{{ pc_id }}" data-step="3" role="group">
      <p class="pcq__eyebrow-{{ pc_id }}">Question 3 of 3</p>
      <h2 class="pcq__heading-{{ pc_id }}">{{ block.settings.q3_heading }}</h2>
      <div class="pcq__options-{{ pc_id }}" role="radiogroup" aria-label="{{ block.settings.q3_heading | strip_html }}">
        {%- for opt in q3_options -%}
          <label class="pcq__option-{{ pc_id }}">
            <input type="radio" name="pcq-q3-{{ pc_id }}" value="{{ opt | strip }}" data-advance="4">
            <span class="pcq__option-marker-{{ pc_id }}"></span>
            <span>{{ opt | strip }}</span>
          </label>
        {%- endfor -%}
      </div>
      <button type="button" class="pcq__back-{{ pc_id }}" data-back="2">← Back</button>
    </div>

    {%- comment -%} ── STEP 4 — Email gate (before result) ── {%- endcomment -%}
    <div class="pcq__step-{{ pc_id }}" data-step="4" role="group">
      <p class="pcq__eyebrow-{{ pc_id }}">One last thing</p>
      <h2 class="pcq__heading-{{ pc_id }}">{{ block.settings.gate_heading }}</h2>
      {%- if block.settings.gate_subtitle != blank -%}
        <p class="pcq__subtitle-{{ pc_id }}">{{ block.settings.gate_subtitle }}</p>
      {%- endif -%}

      <div class="pcq__field-{{ pc_id }}">
        <label for="pcq-email-{{ pc_id }}" class="pcq__label-{{ pc_id }}">{{ block.settings.email_label }}</label>
        <input type="email" id="pcq-email-{{ pc_id }}" class="pcq__input-{{ pc_id }}" placeholder="{{ block.settings.email_placeholder }}" autocomplete="email" required>
      </div>

      {%- if block.settings.show_consent -%}
        <div class="pcq__check-{{ pc_id }}">
          <input type="checkbox" id="pcq-consent-{{ pc_id }}" required>
          <label for="pcq-consent-{{ pc_id }}">{{ block.settings.consent_text }}</label>
        </div>
      {%- endif -%}

      <button type="button" class="pcq__btn-{{ pc_id }}" data-submit>{{ block.settings.gate_btn_label }}</button>
      <div class="pcq__feedback-{{ pc_id }}" role="alert" aria-live="assertive"></div>
      <button type="button" class="pcq__back-{{ pc_id }}" data-back="3">← Back</button>
    </div>

    {%- comment -%} ── STEP 5 — Result (dynamic per match) ── {%- endcomment -%}
    <div class="pcq__step-{{ pc_id }}" data-step="5" role="group">

      {%- comment -%} PURE {%- endcomment -%}
      <div class="pcq__result-card-{{ pc_id }}" data-match="pure">
        {%- if p_pure != blank -%}
          {%- if p_pure.featured_image -%}<img class="pcq__result-img-{{ pc_id }}" src="{{ p_pure.featured_image | image_url: width: 560 }}" alt="{{ p_pure.title | escape }}" loading="lazy" width="280">{%- endif -%}
          <p class="pcq__result-eyebrow-{{ pc_id }}">Your match</p>
          <h2 class="pcq__result-name-{{ pc_id }}">{{ p_pure.title }}</h2>
          <p class="pcq__result-desc-{{ pc_id }}">{{ block.settings.desc_pure }}</p>
          <p class="pcq__result-price-{{ pc_id }}">{{ p_pure.price | money }}</p>
          {%- if discount != blank -%}<span class="pcq__result-code-{{ pc_id }}">20% off · {{ discount }}</span>{%- endif -%}
          <a class="pcq__btn-{{ pc_id }}" data-shop href="{% if discount != blank %}/discount/{{ discount }}?redirect={{ p_pure.url }}{% else %}{{ p_pure.url }}{% endif %}">{{ block.settings.shop_btn_label }}</a>
        {%- endif -%}
      </div>

      {%- comment -%} KALPA {%- endcomment -%}
      <div class="pcq__result-card-{{ pc_id }}" data-match="kalpa">
        {%- if p_kalpa != blank -%}
          {%- if p_kalpa.featured_image -%}<img class="pcq__result-img-{{ pc_id }}" src="{{ p_kalpa.featured_image | image_url: width: 560 }}" alt="{{ p_kalpa.title | escape }}" loading="lazy" width="280">{%- endif -%}
          <p class="pcq__result-eyebrow-{{ pc_id }}">Your match</p>
          <h2 class="pcq__result-name-{{ pc_id }}">{{ p_kalpa.title }}</h2>
          <p class="pcq__result-desc-{{ pc_id }}">{{ block.settings.desc_kalpa }}</p>
          <p class="pcq__result-price-{{ pc_id }}">{{ p_kalpa.price | money }}</p>
          {%- if discount != blank -%}<span class="pcq__result-code-{{ pc_id }}">20% off · {{ discount }}</span>{%- endif -%}
          <a class="pcq__btn-{{ pc_id }}" data-shop href="{% if discount != blank %}/discount/{{ discount }}?redirect={{ p_kalpa.url }}{% else %}{{ p_kalpa.url }}{% endif %}">{{ block.settings.shop_btn_label }}</a>
        {%- endif -%}
      </div>

      {%- comment -%} ROOT {%- endcomment -%}
      <div class="pcq__result-card-{{ pc_id }}" data-match="root">
        {%- if p_root != blank -%}
          {%- if p_root.featured_image -%}<img class="pcq__result-img-{{ pc_id }}" src="{{ p_root.featured_image | image_url: width: 560 }}" alt="{{ p_root.title | escape }}" loading="lazy" width="280">{%- endif -%}
          <p class="pcq__result-eyebrow-{{ pc_id }}">Your match</p>
          <h2 class="pcq__result-name-{{ pc_id }}">{{ p_root.title }}</h2>
          <p class="pcq__result-desc-{{ pc_id }}">{{ block.settings.desc_root }}</p>
          <p class="pcq__result-price-{{ pc_id }}">{{ p_root.price | money }}</p>
          {%- if discount != blank -%}<span class="pcq__result-code-{{ pc_id }}">20% off · {{ discount }}</span>{%- endif -%}
          <a class="pcq__btn-{{ pc_id }}" data-shop href="{% if discount != blank %}/discount/{{ discount }}?redirect={{ p_root.url }}{% else %}{{ p_root.url }}{% endif %}">{{ block.settings.shop_btn_label }}</a>
        {%- endif -%}
      </div>

    </div>

  </div>
</div>

<script>
(function () {
  var id      = {{ pc_id | json }};
  var root    = document.querySelector('.pcq-' + id);
  if (!root) return;

  var webhook = {{ block.settings.webhook_url | json }};
  var source  = {{ block.settings.source_tag | json }};
  var errMsg  = {{ block.settings.error_message | json }};

  var steps   = root.querySelectorAll('.pcq__step-' + id);
  var dots    = root.querySelectorAll('[data-dot]');
  var feedback = root.querySelector('.pcq__feedback-' + id);
  var emailEl  = root.querySelector('#pcq-email-' + id);
  var consentEl = root.querySelector('#pcq-consent-' + id);
  var submitBtn = root.querySelector('[data-submit]');

  var answers = { q1: null, q2: null, q3: null, blend1: null, blend2: null };

  function goTo(step) {
    steps.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-step') === String(step)); });
    dots.forEach(function (d) {
      var n = parseInt(d.getAttribute('data-dot'), 10);
      d.classList.toggle('is-done', n <= Math.min(step, 4));
    });
    // move focus to the new step's heading for a11y
    var active = root.querySelector('.pcq__step-' + id + '.is-active h2');
    if (active) { active.setAttribute('tabindex', '-1'); active.focus({ preventScroll: false }); }
  }

  // Option selection: highlight + record + auto-advance
  root.querySelectorAll('.pcq__option-' + id + ' input').forEach(function (input) {
    input.addEventListener('change', function () {
      var group = input.closest('.pcq__options-' + id);
      group.querySelectorAll('.pcq__option-' + id).forEach(function (l) { l.classList.remove('is-selected'); });
      input.closest('.pcq__option-' + id).classList.add('is-selected');

      var name = input.name;
      if (name.indexOf('q1') !== -1) { answers.q1 = input.value; answers.blend1 = input.getAttribute('data-blend'); }
      else if (name.indexOf('q2') !== -1) { answers.q2 = input.value; answers.blend2 = input.getAttribute('data-blend'); }
      else if (name.indexOf('q3') !== -1) { answers.q3 = input.value; }

      var next = input.getAttribute('data-advance');
      if (next) { setTimeout(function () { goTo(parseInt(next, 10)); }, 260); }
    });
  });

  // Back buttons
  root.querySelectorAll('[data-back]').forEach(function (btn) {
    btn.addEventListener('click', function () { goTo(parseInt(btn.getAttribute('data-back'), 10)); });
  });

  // Scoring: tally blend1 + blend2; tie/mixed -> pure (the versatile base)
  function computeMatch() {
    var tally = { pure: 0, kalpa: 0, root: 0 };
    if (answers.blend1) tally[answers.blend1]++;
    if (answers.blend2) tally[answers.blend2]++;
    var top = 'pure', topScore = -1, tie = false;
    ['kalpa', 'root', 'pure'].forEach(function (k) {
      if (tally[k] > topScore) { topScore = tally[k]; top = k; tie = false; }
      else if (tally[k] === topScore) { tie = true; }
    });
    return tie ? 'pure' : top;
  }

  function showFeedback(msg) {
    feedback.textContent = msg;
    feedback.classList.add('is-visible');
  }

  function showResult(match) {
    root.querySelectorAll('.pcq__result-card-' + id).forEach(function (c) {
      c.classList.toggle('is-match', c.getAttribute('data-match') === match);
    });
    goTo(5);
    dots.forEach(function (d) { d.classList.add('is-done'); });
  }

  // Email gate submit -> validate, fetch, then reveal result
  if (submitBtn) {
    submitBtn.addEventListener('click', function () {
      feedback.classList.remove('is-visible');
      if (!emailEl.value.trim() || !emailEl.validity.valid) { showFeedback(errMsg); emailEl.focus(); return; }
      if (consentEl && !consentEl.checked) { showFeedback(errMsg); return; }

      var match = computeMatch();
      var matchLabel = match.charAt(0).toUpperCase() + match.slice(1);

      var payload = {
        email:       emailEl.value.trim(),
        recipe_type: answers.q1,
        goal:        answers.q2,
        buying_for:  answers.q3,
        chocho_match: matchLabel,
        source:      source || window.location.href,
        page:        document.title,
        timestamp:   new Date().toISOString()
      };

      submitBtn.disabled = true;
      var originalLabel = submitBtn.textContent;
      submitBtn.textContent = '...';

      var reveal = function () { showResult(match); };

      fetch(webhook, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(function (res) {
        // Reveal the result regardless of webhook latency; the lead is what matters.
        reveal();
        if (!res.ok) { console.warn('PC Quiz: webhook responded ' + res.status); }
      })
      .catch(function (err) {
        // Network failed: don't punish the user — still show their match.
        console.warn('PC Quiz: webhook error', err);
        reveal();
      });
    });
  }
})();
</script>

