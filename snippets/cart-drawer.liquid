{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-haspopup="dialog"
    aria-label="{{ 'accessibility.cart' | t }}"
    aria-describedby="cart-bubble-text"
    data-testid="cart-drawer-trigger"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <h2
              class="cart-drawer__heading h3 cart-drawer__heading--empty"
              id="cart-drawer-heading-empty"
            >
              {{ 'content.your_cart_is_empty' | t }}
            </h2>

            <div class="cart-drawer__items">
              {% render 'cart-products' %}
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <h2
              class="cart-drawer__heading h3"
              id="cart-drawer-heading"
            >
              {{ 'content.cart_title' | t }}
              {% render 'cart-bubble' %}
            </h2>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

<script>
  // Reubica el bloque de cuotas (Shop Pay Installments) al final del
  // summary, como nota pequeña debajo de los botones de pago.
  (function () {
    function moveInstallments(root) {
      var scope = root || document;
      scope.querySelectorAll('.cart-drawer__summary').forEach(function (summary) {
        var installments = summary.querySelector('.cart__installments');
        if (installments && installments.parentElement !== summary) {
          summary.appendChild(installments);
        }
      });
    }

    // Corre al cargar y cada vez que el carrito se actualiza (el tema
    // re-renderiza el summary tras cambios de cantidad/descuento).
    document.addEventListener('DOMContentLoaded', function () {
      moveInstallments();
    });

    var observer = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        if (mutations[i].addedNodes.length) {
          moveInstallments();
          break;
        }
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }

  /* =========================================================
     CART ITEMS — Minimalista & Mobile-First
  ========================================================= */

  .cart-drawer__items {
    padding-inline: var(--cart-drawer-padding);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__items {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-items__table {
    display: block;
    width: 100%;
    border-collapse: collapse;
  }

  .cart-items__table tbody {
    display: block;
  }

  /* Grid limpio: imagen | detalles (2 filas) | columna derecha (precio + acciones) */
  .cart-items__table-row {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    grid-template-areas:
      'media details price'
      'media details actions';
    column-gap: 16px;
    row-gap: 4px;
    padding-block: 20px;
    border-bottom: 1px solid rgba(var(--color-border-rgb), 0.08);
    align-items: start;
  }

  .cart-items__table-row:first-child {
    padding-top: 4px;
  }

  .cart-items__table-row > td {
    display: block;
    padding: 0;
    margin: 0;
  }

  /* ----- Media ----- */
  .cart-items__media {
    grid-area: media;
    align-self: start;
  }

  .cart-items__media-container {
    display: block;
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    background-color: rgba(var(--color-border-rgb), 0.06);
  }

  .cart-items__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ----- Details (centro, ocupa 2 filas) ----- */
  .cart-items__details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding-top: 2px;
  }

  .cart-items__title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Opciones / variantes como pills sutiles */
  .cart-items__details .list-unstyled {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-items__details .list-unstyled li {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground-rgb, var(--color-foreground)), 0.75);
    background-color: rgba(var(--color-border-rgb), 0.08);
    padding: 3px 8px;
    border-radius: 6px;
    width: fit-content;
    line-height: 1;
  }

  /* Precio unitario / compare-at (más tenue) */
  .cart-items__details .unit-price,
  .cart-items__details .price-per-item,
  .cart-items__details > div:last-child {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 2px;
  }

  .cart-items__details .unit-price span:not(.visually-hidden),
  .cart-items__details .price-per-item span:not(.visually-hidden),
  .cart-items__details > div:last-child span:not(.visually-hidden) {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .cart-items__details .compare-at-price {
    font-size: 0.78rem;
    opacity: 0.45;
    text-decoration: line-through;
  }

  /* ----- Price (total del line item, arriba a la derecha) ----- */
  .cart-items__price {
    grid-area: price;
    align-self: start;
    justify-self: end;
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-foreground);
    line-height: 1.3;
    padding-top: 2px;
  }

  /* ----- Actions (cantidad + remove, abajo a la derecha) ----- */
  .cart-items__quantity {
    grid-area: actions;
    align-self: end;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }

  .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(var(--color-border-rgb), 0.15);
    border-radius: 999px;
    padding: 2px;
    background-color: rgba(var(--color-border-rgb), 0.03);
  }

  .quantity-selector button {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .quantity-selector button:hover {
    background-color: rgba(var(--color-border-rgb), 0.12);
  }

  .quantity-selector input {
    width: 32px;
    border: none;
    background: transparent;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-foreground);
    -moz-appearance: textfield;
  }

  .quantity-selector input::-webkit-outer-spin-button,
  .quantity-selector input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-items__remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    opacity: 0.4;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    transition: opacity 0.15s ease;
  }

  .cart-items__remove:hover {
    opacity: 0.85;
  }

  .cart-items__remove svg {
    width: 16px;
    height: 16px;
  }

  /* ----- Error ----- */
  .cart-items__error {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: 0.8rem;
  }

  .cart-items__error:not(.hidden) {
    display: block;
  }

  /* =========================================================
     Summary — Descuento / Totales / CTAs
  ========================================================= */

  .cart-drawer__summary {
    padding: var(--cart-drawer-padding);
    border-top: 1px solid rgba(var(--color-border-rgb), 0.08);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__summary {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-actions .disclosure-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 8px;
    border: none;
    background: none;
  }

  .disclosure-trigger__label {
    font-weight: 600;
    font-size: 0.82rem;
  }

  .cart-discount__form {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .cart-discount__input {
    flex: 1;
    min-width: 0;
    border: 1px solid rgba(var(--color-border-rgb), 0.18);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.82rem;
  }

  .cart-discount__button {
    border-radius: 8px;
    padding-inline: 16px;
    font-size: 0.78rem;
  }

  .cart-discount__codes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    padding: 0;
    list-style: none;
  }

  .cart-discount__pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: rgba(var(--color-border-rgb), 0.07);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .cart__total-container {
    padding-top: 12px;
    margin-top: 4px;
    border-top: 1px solid rgba(var(--color-border-rgb), 0.08);
  }

  .cart__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .cart__total-label {
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.7;
  }

  .cart__total-value {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .tax-note {
    opacity: 0.5;
    font-size: 0.72rem;
    margin-top: 4px;
  }

  /* Installments reubicado al final (ver script) */
  .cart__installments {
    display: block;
    margin-top: 14px;
    text-align: center;
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .cart__installments shopify-payment-terms {
    font-size: 0.72rem;
  }

  .cart__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .cart__checkout-button {
    width: 100%;
    border-radius: 999px;
    padding-block: 15px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* =========================================================
     Wallets — Forzados a ROW en mobile y desktop
  ========================================================= */

  .additional-checkout-buttons {
    margin-top: 4px;
    --shopify-accelerated-checkout-button-block-size: 44px;
    --shopify-accelerated-checkout-button-inline-size: 44px;
    --shopify-accelerated-checkout-inline-alignment: stretch;
  }

  .additional-checkout-buttons .wallet-cart-grid,
  .additional-checkout-buttons .wallet-cart-grid--vertical,
  .additional-checkout-buttons .accelerated-checkout-button-container,
  .additional-checkout-buttons .wallet-cart-button {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: 8px;
    margin: 0 !important;
    width: 100% !important;
  }

  .additional-checkout-buttons .wallet-cart-button-container,
  .additional-checkout-buttons .accelerated-checkout-button-container {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    width: auto !important;
    margin: 0 !important;
    max-width: none !important;
  }

  /* =========================================================
     Mobile refinements
  ========================================================= */

  @media screen and (max-width: 749px) {
    .cart-items__table-row {
      grid-template-columns: 72px 1fr auto;
      column-gap: 12px;
      padding-block: 16px;
    }

    .cart-items__media-container {
      width: 72px;
      height: 72px;
    }

    .cart-items__title {
      font-size: 0.9rem;
    }

    .cart-items__price {
      font-size: 0.9rem;
    }

    .quantity-selector button {
      width: 26px;
      height: 26px;
    }

    .quantity-selector input {
      width: 28px;
      font-size: 0.82rem;
    }

    .cart-items__remove {
      width: 26px;
      height: 26px;
    }

    .cart__checkout-button {
      padding-block: 14px;
    }
  }

  /* Pantallas muy estrechas: wallets un poco más compactos */
  @media screen and (max-width: 400px) {
    .additional-checkout-buttons {
      --shopify-accelerated-checkout-button-block-size: 40px;
      --shopify-accelerated-checkout-button-inline-size: 40px;
    }

    .additional-checkout-buttons .wallet-cart-grid,
    .additional-checkout-buttons .wallet-cart-grid--vertical,
    .additional-checkout-buttons .accelerated-checkout-button-container,
    .additional-checkout-buttons .wallet-cart-button {
      gap: 6px;
    }
  }
{% endstylesheet %}