{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  /* =========================================================
     CART ITEMS — Layout semántico con CSS Grid
     Reemplaza tabla obsoleta por divs accesibles
  ========================================================= */

  .cart-items {
    display: block;
    width: 100%;
  }

  /* Grid de 3 columnas x 2 filas */
  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    grid-template-areas:
      "media details price"
      "media quantity remove";
    column-gap: 16px;
    row-gap: 10px;
    padding-block: 20px;
    border-bottom: 1px solid rgba(var(--color-border-rgb), 0.08);
    align-items: start;
  }

  .cart-item:first-child {
    padding-top: 4px;
  }

  /* ----- Media (Imagen 80px, ocupa 2 filas) ----- */
  .cart-item__media {
    grid-area: media;
    align-self: start;
  }

  .cart-item__media-link {
    display: block;
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    background-color: rgba(var(--color-border-rgb), 0.06);
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-item__media-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    background-color: rgba(var(--color-border-rgb), 0.06);
  }

  /* ----- Details (Título + Suscripción + Opciones) ----- */
  .cart-item__details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    padding-top: 2px;
  }

  .cart-item__title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--color-foreground);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-item__subscription {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(var(--color-foreground-rgb, var(--color-foreground)), 0.7);
    margin: 0;
    line-height: 1.3;
  }

  .cart-item__options {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-item__options li {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground-rgb, var(--color-foreground)), 0.75);
    background-color: rgba(var(--color-border-rgb), 0.08);
    padding: 2px 7px;
    border-radius: 5px;
    width: fit-content;
    line-height: 1.4;
  }

  .cart-item__properties {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .cart-item__property {
    font-size: 0.72rem;
    opacity: 0.6;
  }

  /* ----- Price (Total del line item, arriba a la derecha) ----- */
  .cart-item__price {
    grid-area: price;
    align-self: start;
    justify-self: end;
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-foreground);
    line-height: 1.3;
    padding-top: 2px;
  }

  .cart-item__price-compare {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.45;
    text-decoration: line-through;
    margin-bottom: 2px;
  }

  /* ----- Quantity (Fila 2, alineado debajo del título) ----- */
  .cart-item__quantity {
    grid-area: quantity;
    align-self: center;
    justify-self: start;
    display: flex;
    align-items: center;
  }

  .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(var(--color-border-rgb), 0.15);
    border-radius: 999px;
    padding: 2px;
    background-color: rgba(var(--color-border-rgb), 0.03);
  }

  .quantity-selector__button {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .quantity-selector__button:hover:not([disabled]) {
    background-color: rgba(var(--color-border-rgb), 0.12);
  }

  .quantity-selector__button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .quantity-selector__input {
    width: 32px;
    border: none;
    background: transparent;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-foreground);
    -moz-appearance: textfield;
  }

  .quantity-selector__input::-webkit-outer-spin-button,
  .quantity-selector__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ----- Remove (Fila 2, derecha, alineado con precio) ----- */
  .cart-item__remove {
    grid-area: remove;
    align-self: center;
    justify-self: end;
    display: flex;
    align-items: center;
  }

  .cart-item__remove-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    opacity: 0.4;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    transition: opacity 0.15s ease;
  }

  .cart-item__remove-button:hover {
    opacity: 0.85;
  }

  .cart-item__remove-button svg {
    width: 16px;
    height: 16px;
  }

  /* ----- Error (Span completo, debajo de todo) ----- */
  .cart-item__error {
    grid-column: 1 / -1;
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--color-error, #d93535);
  }

  .cart-item__error.hidden {
    display: none;
  }

  /* =========================================================
     Summary — Descuento / Totales / CTAs
  ========================================================= */

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
    padding: var(--cart-drawer-padding);
    border-top: 1px solid rgba(var(--color-border-rgb), 0.08);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__summary {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-actions .disclosure-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 8px;
    border: none;
    background: none;
  }

  .disclosure-trigger__label {
    font-weight: 600;
    font-size: 0.82rem;
  }

  .cart-discount__form {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .cart-discount__input {
    flex: 1;
    min-width: 0;
    border: 1px solid rgba(var(--color-border-rgb), 0.18);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.82rem;
  }

  .cart-discount__button {
    border-radius: 8px;
    padding-inline: 16px;
    font-size: 0.78rem;
  }

  .cart-discount__codes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    padding: 0;
    list-style: none;
  }

  .cart-discount__codes:empty {
    margin-top: 0;
  }

  .cart-discount__pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: rgba(var(--color-border-rgb), 0.07);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .cart__total-container {
    padding-top: 12px;
    margin-top: 4px;
    border-top: 1px solid rgba(var(--color-border-rgb), 0.08);
  }

  .cart__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .cart__total-label {
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.7;
  }

  .cart__total-value {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .tax-note {
    opacity: 0.5;
    font-size: 0.72rem;
    margin-top: 4px;
  }

  .cart__installments {
    display: block;
    margin-top: 12px;
    text-align: center;
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .cart__installments shopify-payment-terms {
    font-size: 0.72rem;
  }

  .cart__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .cart__checkout-button {
    width: 100%;
    border-radius: 999px;
    padding-block: 15px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* =========================================================
     Wallets — Forzados a ROW en mobile y desktop
  ========================================================= */

  .additional-checkout-buttons {
    margin-top: 4px;
    --shopify-accelerated-checkout-button-block-size: 44px;
    --shopify-accelerated-checkout-button-inline-size: 44px;
    --shopify-accelerated-checkout-inline-alignment: stretch;
    --shopify-accelerated-checkout-row-gap: 10px;
  }

  .additional-checkout-buttons .wallet-cart-grid,
  .additional-checkout-buttons .wallet-cart-grid--vertical,
  .additional-checkout-buttons .accelerated-checkout-button-container,
  .additional-checkout-buttons .wallet-cart-button {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: 8px;
    margin: 0 !important;
    width: 100% !important;
  }

  .additional-checkout-buttons .wallet-cart-button-container,
  .additional-checkout-buttons .accelerated-checkout-button-container {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    width: auto !important;
    margin: 0 !important;
    max-width: none !important;
  }

  #shopify-buyer-consent {
    display: none;
    margin-top: 10px;
    font-size: 0.66rem;
    line-height: 1.4;
    opacity: 0.55;
    text-align: left;
  }

  #shopify-subscription-policy-button {
    text-decoration: underline;
    cursor: pointer;
  }

  /* =========================================================
     Mobile refinements
  ========================================================= */

  @media screen and (max-width: 749px) {
    .cart-item {
      grid-template-columns: 64px 1fr auto;
      column-gap: 12px;
      row-gap: 8px;
      padding-block: 16px;
    }

    .cart-item__media-link,
    .cart-item__media-placeholder {
      width: 64px;
      height: 64px;
    }

    .cart-item__title {
      font-size: 0.9rem;
    }

    .cart-item__price {
      font-size: 0.9rem;
    }

    .quantity-selector__button {
      width: 26px;
      height: 26px;
    }

    .quantity-selector__input {
      width: 28px;
      font-size: 0.82rem;
    }

    .cart-item__remove-button {
      width: 26px;
      height: 26px;
    }

    .cart__checkout-button {
      padding-block: 14px;
    }

    .cart__ctas {
      margin-inline: calc(-1 * var(--cart-drawer-padding));
      padding-inline: 8px;
    }
  }

  @media screen and (max-width: 370px) {
    .cart-item {
      grid-template-columns: 56px 1fr auto;
      column-gap: 10px;
    }

    .cart-item__media-link,
    .cart-item__media-placeholder {
      width: 56px;
      height: 56px;
    }

    .additional-checkout-buttons {
      --shopify-accelerated-checkout-button-block-size: 42px;
      --shopify-accelerated-checkout-button-inline-size: 42px;
      --shopify-accelerated-checkout-row-gap: 8px;
    }

    .additional-checkout-buttons .wallet-cart-grid,
    .additional-checkout-buttons .wallet-cart-grid--vertical,
    .additional-checkout-buttons .accelerated-checkout-button-container,
    .additional-checkout-buttons .wallet-cart-button {
      gap: 6px;
    }
  }
{% endstylesheet %}