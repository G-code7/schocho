{%- doc -%}
  Pronto Chocho — Selector de compra en 2 pasos: sabor → plan.

  - Paso 1 (si hay más de un sabor): fichas con foto y nombre corto.
    En el PDP cambiar de sabor navega a ese producto (la página cambia
    completa); fuera del PDP cambia en el mismo lugar.
  - Paso 2: Subscribe & Save vs compra única, con precio, ahorro y
    frecuencia REALES desde selling_plan_allocations.
  - Siempre arranca con un sabor y un plan elegidos: nunca en $0.00.

  Metafields de producto opcionales:
    custom.short_name       → nombre en la ficha (PURE, KALLPA, ROOT)
    custom.nutrition_badge  → línea bajo el nombre (p. ej. "25g protein, 9g fiber")
    custom.servings         → porciones por unidad (precio por porción)

  @param {product} product - Producto seleccionado al cargar (obligatorio)
  @param {product[]} [flavors] - Sabores a mostrar (debe incluir a product)
  @param {boolean} [navigate] - true en el PDP: cambiar sabor = ir a su página
  @param {string} uid
  @param {string} [attrs] - block.shopify_attributes
  @param {string} [default_option] - 'subscription' | 'onetime'
  @param {string} [flavor_label]
  @param {string} [plan_label]
  @param {string} [sub_title]
  @param {string} [sub_badge] - Admite [percent]
  @param {string} [benefits] - Uno por línea
  @param {string} [onetime_title]
  @param {string} [onetime_subtitle]
  @param {string} [onetime_codes] - Separados por coma
  @param {string} [note_sub] - Una línea bajo el botón con suscripción
  @param {string} [note_onetime] - Una línea bajo el botón con compra única
  @param {boolean} [show_per_serving]
  @param {number} [servings]
  @param {string} [per_label]
  @param {boolean} [show_quantity]
  @param {string} [atc_text]
  @param {boolean} [show_dynamic_checkout]
  @param {boolean} [open_drawer]
  @param {boolean} [sticky_mobile]
  @param {string} [style]
{%- enddoc -%}
{%- if product != blank -%}
  {%- liquid
    assign uid = uid | default: product.id | replace: '_', '-' | downcase

    # ---- Sabores: solo si la lista incluye al producto actual ----
    assign show_flavors = false
    assign sel = 0
    if flavors.size > 1
      for fp in flavors
        if fp.id == product.id
          assign show_flavors = true
          assign sel = forloop.index0
          break
        endif
      endfor
    endif
    assign n_flavors = 1
    if show_flavors
      assign n_flavors = flavors.size
    endif

    # ---- Estado inicial (producto seleccionado) ----
    assign sv = product.selected_or_first_available_variant
    assign allocs = sv.selling_plan_allocations
    assign has_plans = false
    if allocs.size > 0
      assign has_plans = true
    endif
    assign sel_alloc = allocs.first

    assign type = default_option | default: 'subscription'
    unless has_plans
      assign type = 'onetime'
    endunless
    if product.requires_selling_plan and has_plans
      assign type = 'subscription'
    endif

    assign ref = sv.price
    if sv.compare_at_price > sv.price
      assign ref = sv.compare_at_price
    endif
    assign save_pct = 0
    if has_plans and ref > sel_alloc.price
      assign save_pct = ref | minus: sel_alloc.price | times: 100.0 | divided_by: ref | round
    endif

    assign unit = sv.price
    if type == 'subscription'
      assign unit = sel_alloc.price
    endif

    assign badge = sub_badge | default: 'Save [percent]%'
    if badge contains '[percent]'
      if save_pct > 0
        assign badge = badge | replace: '[percent]', save_pct
      else
        assign badge = ''
      endif
    endif

    assign frequency = sel_alloc.selling_plan.name | split: ',' | first | strip
    assign servings_n = product.metafields.custom.servings.value | default: servings | default: 0 | plus: 0
    assign per = per_label | default: 'serving'
    assign atc_label = atc_text | default: 'Add to cart'

    assign codes_probe = onetime_codes | default: '' | remove: ',' | strip
    assign note = note_onetime
    if type == 'subscription'
      assign note = note_sub
    endif
  -%}

  {{ 'pc-buy-box.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pc-buy-box.js' | asset_url }}" type="module" defer></script>

  <pc-buy-box
    class="pc-bb"
    id="pc-bb-{{ uid }}"
    data-pc-tracked
    {% if style != blank %}style="{{ style }}"{% endif %}
    {{ attrs }}
  >
    <script type="application/json" data-pc-data>
      {
        "selected": {{ sel }},
        "navigate": {% if navigate %}true{% else %}false{% endif %},
        "locale": {{ request.locale.iso_code | json }},
        "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
        "type": {{ type | json }},
        "planId": {% if has_plans %}{{ sel_alloc.selling_plan.id }}{% else %}null{% endif %},
        "badge": {{ sub_badge | default: 'Save [percent]%' | json }},
        "perLabel": {{ per | json }},
        "atcText": {{ atc_label | json }},
        "notes": { "subscription": {{ note_sub | default: '' | json }}, "onetime": {{ note_onetime | default: '' | json }} },
        "openDrawer": {% if open_drawer == false %}false{% else %}true{% endif %},
        "codes": {{ onetime_codes | default: '' | remove: ' ' | split: ',' | json }},
        "routes": {
          "add": {{ routes.cart_add_url | append: '.js' | json }},
          "update": {{ routes.cart_update_url | append: '.js' | json }},
          "cart": {{ routes.cart_url | append: '.js' | json }},
          "cartPage": {{ routes.cart_url | json }}
        },
        "texts": {
          "adding": "Adding…",
          "soldOut": "Sold out",
          "error": "We couldn't add this to your cart. Please try again.",
          "save": "You save"
        },
        "flavors": [
          {%- for i in (1..n_flavors) -%}
            {%- liquid
              if show_flavors
                assign fp = flavors[forloop.index0]
              else
                assign fp = product
              endif
              assign fv = fp.selected_or_first_available_variant
              assign f_servings = fp.metafields.custom.servings.value | default: servings | default: 0 | plus: 0
            -%}
            {
              "productId": {{ fp.id }},
              "url": {{ fp.url | json }},
              "title": {{ fp.title | json }},
              "short": {{ fp.metafields.custom.short_name.value | default: fp.title | json }},
              "nutrition": {{ fp.metafields.custom.nutrition_badge.value | default: '' | json }},
              "available": {{ fv.available | json }},
              "requiresPlan": {{ fp.requires_selling_plan | json }},
              "variantId": {{ fv.id }},
              "price": {{ fv.price }},
              "compare": {{ fv.compare_at_price | default: 0 }},
              "servings": {{ f_servings }},
              "plans": [
                {%- for a in fv.selling_plan_allocations -%}
                  {"id": {{ a.selling_plan.id }}, "name": {{ a.selling_plan.name | json }}, "price": {{ a.price }}}
                  {%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>

    {%- if show_flavors -%}
      <fieldset class="pc-bb__step">
        <legend class="pc-bb__step-title">
          <span class="pc-bb__step-num" aria-hidden="true">1</span>
          {{- flavor_label | default: 'Choose your flavor' -}}
        </legend>
        <div class="pc-bb__flavors">
          {%- for fp in flavors -%}
            {%- assign fv = fp.selected_or_first_available_variant -%}
            <label class="pc-bb__flavor{% if forloop.index0 == sel %} is-active{% endif %}">
              <input
                type="radio"
                class="pc-bb__visually-hidden"
                name="pc-bb-flavor-{{ uid }}"
                value="{{ forloop.index0 }}"
                data-pc-flavor
                autocomplete="off"
                {% if forloop.index0 == sel %}checked{% endif %}
                {% unless fv.available %}disabled{% endunless %}
              >
              <span class="pc-bb__flavor-img">
                {%- if fp.featured_image -%}
                  {{ fp.featured_image | image_url: width: 240 | image_tag: width: 120, height: 120, loading: 'lazy', alt: '' }}
                {%- endif -%}
              </span>
              <span class="pc-bb__flavor-name">{{ fp.metafields.custom.short_name.value | default: fp.title }}</span>
              {%- unless fv.available -%}<span class="pc-bb__flavor-out">Sold out</span>{%- endunless -%}
            </label>
          {%- endfor -%}
        </div>
        <p class="pc-bb__flavor-title" data-pc-flavor-title>{{ product.title }}</p>
        {%- assign nb = product.metafields.custom.nutrition_badge.value -%}
        <p class="pc-bb__flavor-nutrition" data-pc-flavor-nutrition{% if nb == blank %} hidden{% endif %}>{{ nb }}</p>
      </fieldset>
    {%- endif -%}

    <fieldset class="pc-bb__step">
      <legend class="pc-bb__step-title{% unless show_flavors %} pc-bb__visually-hidden{% endunless %}">
        {%- if show_flavors -%}<span class="pc-bb__step-num" aria-hidden="true">2</span>{%- endif -%}
        {{- plan_label | default: 'Choose your plan' -}}
      </legend>

      <div class="pc-bb__options">
        {%- comment -%} Subscribe & Save {%- endcomment -%}
        <div
          class="pc-bb__option{% if type == 'subscription' %} is-active{% endif %}"
          data-pc-option="subscription"
          {% unless has_plans %}hidden{% endunless %}
        >
          <label class="pc-bb__option-main">
            <input
              type="radio"
              class="pc-bb__visually-hidden"
              name="pc-bb-type-{{ uid }}"
              value="subscription"
              data-pc-type
              autocomplete="off"
              {% if type == 'subscription' %}checked{% endif %}
            >
            <span class="pc-bb__radio" aria-hidden="true"></span>
            <span class="pc-bb__option-body">
              <span class="pc-bb__option-head">
                <span class="pc-bb__option-title">
                  {{- sub_title | default: 'Subscribe & Save' -}}
                  <span class="pc-bb__badge" data-pc-badge{% if badge == blank %} hidden{% endif %}>{{ badge }}</span>
                </span>
                <span class="pc-bb__price">
                  <s data-pc-sub-compare{% unless ref > sel_alloc.price %} hidden{% endunless %}>{{ ref | money }}</s>
                  <strong data-pc-sub-price>{{ sel_alloc.price | money }}</strong>
                </span>
              </span>
              <span class="pc-bb__meta">
                <span data-pc-frequency>{{ frequency }}</span>
                {%- if show_per_serving != false -%}
                  <span data-pc-sub-per{% if servings_n == 0 %} hidden{% endif %}>
                    {%- if servings_n > 0 %}{{ sel_alloc.price | divided_by: servings_n | money }} per {{ per }}{% endif -%}
                  </span>
                {%- endif -%}
              </span>
            </span>
          </label>

          <div class="pc-bb__plan" data-pc-plan-wrap{% if allocs.size < 2 %} hidden{% endif %}>
            <label class="pc-bb__visually-hidden" for="pc-bb-plan-{{ uid }}">Delivery frequency</label>
            <select id="pc-bb-plan-{{ uid }}" class="pc-bb__select" data-pc-plan autocomplete="off">
              {%- for a in allocs -%}
                <option value="{{ a.selling_plan.id }}"{% if forloop.first %} selected{% endif %}>{{ a.selling_plan.name }}</option>
              {%- endfor -%}
            </select>
          </div>

          {%- if benefits != blank -%}
            {%- assign benefit_lines = benefits | newline_to_br | split: '<br />' -%}
            <ul class="pc-bb__benefits">
              {%- for line in benefit_lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- comment -%} Compra única {%- endcomment -%}
        <div
          class="pc-bb__option{% if type == 'onetime' %} is-active{% endif %}"
          data-pc-option="onetime"
          {% if product.requires_selling_plan %}hidden{% endif %}
        >
          <label class="pc-bb__option-main">
            <input
              type="radio"
              class="pc-bb__visually-hidden"
              name="pc-bb-type-{{ uid }}"
              value="onetime"
              data-pc-type
              autocomplete="off"
              {% if type == 'onetime' %}checked{% endif %}
            >
            <span class="pc-bb__radio" aria-hidden="true"></span>
            <span class="pc-bb__option-body">
              <span class="pc-bb__option-head">
                <span class="pc-bb__option-title">{{ onetime_title | default: 'One-time purchase' }}</span>
                <span class="pc-bb__price">
                  <s data-pc-ot-compare{% unless sv.compare_at_price > sv.price %} hidden{% endunless %}>{{ sv.compare_at_price | money }}</s>
                  <strong data-pc-ot-price>{{ sv.price | money }}</strong>
                </span>
              </span>
              <span class="pc-bb__meta">
                {%- if onetime_subtitle != blank -%}<span>{{ onetime_subtitle }}</span>{%- endif -%}
                {%- if show_per_serving != false -%}
                  <span data-pc-ot-per{% if servings_n == 0 %} hidden{% endif %}>
                    {%- if servings_n > 0 %}{{ sv.price | divided_by: servings_n | money }} per {{ per }}{% endif -%}
                  </span>
                {%- endif -%}
              </span>
            </span>
          </label>
        </div>
      </div>
    </fieldset>

    <div class="pc-bb__buy">
      {%- if show_quantity != false -%}
        <span class="pc-bb__stepper">
          <button type="button" data-pc-qty-step="-1" aria-label="Decrease quantity" disabled>−</button>
          <input type="number" inputmode="numeric" min="1" value="1" data-pc-qty autocomplete="off" aria-label="Quantity">
          <button type="button" data-pc-qty-step="1" aria-label="Increase quantity">+</button>
        </span>
      {%- endif -%}
      <button type="button" class="pc-bb__atc" data-pc-add{% unless sv.available %} disabled{% endunless %}>
        <span data-pc-add-label>{% if sv.available %}{{ atc_label }}{% else %}Sold out{% endif %}</span>
        <span class="pc-bb__atc-price" data-pc-add-price{% unless sv.available %} hidden{% endunless %}>{{ unit | money }}</span>
      </button>
    </div>

    <p class="pc-bb__savings" data-pc-savings hidden></p>
    <p class="pc-bb__note" data-pc-note{% if note == blank %} hidden{% endif %}>{{ note }}</p>
    <p class="pc-bb__error" data-pc-error role="alert" hidden></p>

    {%- comment -%}
      Pago rápido: solo compra única del producto inicial y sin códigos.
      Apple Pay / Google Pay / Buy it now se saltan el carrito y no
      aplicarían los códigos de compra única.
    {%- endcomment -%}
    {%- if show_dynamic_checkout != false and codes_probe == blank -%}
      <div class="pc-bb__dynamic" data-pc-dynamic{% if type == 'subscription' %} hidden{% endif %}>
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ sv.id }}">
          <input type="hidden" name="quantity" value="1" data-pc-form-qty>
          {{ form | payment_button }}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if sticky_mobile != false -%}
      <div class="pc-bb-sticky" data-pc-sticky style="{{ style }}">
        <span class="pc-bb-sticky__info">
          <span class="pc-bb-sticky__title" data-pc-sticky-title>{{ product.metafields.custom.short_name.value | default: product.title }}</span>
          <span class="pc-bb-sticky__price" data-pc-sticky-price>{{ unit | money }}</span>
        </span>
        <button type="button" class="pc-bb__atc" data-pc-sticky-add{% unless sv.available %} disabled{% endunless %}>
          {{- atc_label -}}
        </button>
      </div>
    {%- endif -%}
  </pc-buy-box>
{%- endif -%}
