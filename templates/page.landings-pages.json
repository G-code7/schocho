or: #1C1A17;\n  }\n  .pc-var-head em { font-style: italic; color: #8C7B5E; }\n  .pc-var--purple .pc-var-head { border-top: 3px solid #6C4D6E; }\n  .pc-var--terra  .pc-var-head { border-top: 3px solid #B25A45; }\n  .pc-var--sage   .pc-var-head { border-top: 3px solid #5E7060; }\n  .pc-var table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  .pc-var table tr { border-bottom: 1px solid #EDE5D8; }\n  .pc-var table tr:last-child { border-bottom: none; }\n  .pc-var table td {\n    padding: 8px 18px;\n    font-size: 12px;\n    color: #5C5A57;\n  }\n  .pc-var table td:first-child {\n    color: #1C1A17;\n    font-weight: 500;\n  }\n  .pc-var table td:last-child {\n    text-align: right;\n    font-family: 'Courier New', monospace;\n    font-size: 11px;\n    letter-spacing: 0.03em;\n    color: #2F5C3D;\n    font-weight: 600;\n  }\n  .pc-var-note {\n    padding: 10px 18px;\n    font-size: 11.5px;\n    color: #8C7B5E;\n    font-style: italic;\n    line-height: 1.6;\n    border-top: 1px solid #DDD5C5;\n    background: #F4EDE1;\n    margin-top: auto;\n  }\n\n  /* ── COMPLY ── */\n  .pc-comply {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-top: 28px;\n    font-size: 13px;\n    font-weight: 600;\n    color: #3D6B4A;\n    letter-spacing: 0.02em;\n  }\n  .pc-comply::before {\n    content: '✓';\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #EBF4EE;\n    border: 1px solid #A8D4B4;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    flex-shrink: 0;\n    line-height: 1;\n  }\n\n  /* ── FAQ ── */\n  .pc-faq {\n    margin-top: 48px;\n    border: 1px solid #DDD5C5;\n    background: #FDFAF5;\n    transition: box-shadow 0.25s ease;\n  }\n  .pc-faq:hover { box-shadow: 0 6px 24px rgba(28,26,23,0.06); }\n  .pc-faq-top {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 24px;\n    background: #EDE5D8;\n    border-bottom: 1px solid #DDD5C5;\n  }\n  .pc-faq-top span {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #8C7B5E;\n  }\n  .pc-faq-chip {\n    background: #B25A45;\n    color: #FDFAF5;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    padding: 3px 8px;\n    border-radius: 2px;\n  }\n  .pc-faq-body { padding: 24px; }\n  .pc-faq-q {\n    font-family: 'Montserrat', sans-serif;\n    font-size: 16px;\n    font-weight: 600;\n    color: #1C1A17;\n    margin-bottom: 10px;\n    line-height: 1.4;\n  }\n  .pc-faq-a {\n    font-size: 13.5px;\n    color: #5C5A57;\n    line-height: 1.8;\n  }\n  .pc-faq-a a {\n    color: #B25A45;\n    text-decoration: none;\n    border-bottom: 1px solid currentColor;\n    padding-bottom: 1px;\n  }\n\n  /* ── CLOSING ── */\n  .pc-closing {\n    background: #3b1a62;\n    text-align: center;\n    padding: 72px 32px;\n    margin-bottom: 40px;\n    border-radius: 20px;\n    position: relative;\n    overflow: hidden;\n  }\n  .pc-closing::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse 70% 80% at 50% 110%, #6C4D6E55, transparent 60%);\n    pointer-events: none;\n  }\n  .pc-closing p {\n    font-family: 'Montserrat', sans-serif;\n    font-size: 26px;\n    font-weight: 400;\n    font-style: italic;\n    line-height: 1.45;\n    color: #EDE5D8;\n    max-width: 560px;\n    margin: 0 auto 24px;\n    position: relative;\n  }\n  .pc-closing p em {\n    font-style: normal;\n    color: #C8A87A;\n  }\n  .pc-closing-line {\n    width: 40px;\n    height: 1px;\n    background: #C8A87A;\n    opacity: 0.5;\n    margin: 0 auto 20px;\n  }\n  .pc-closing-brand {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #ffffff;\n    position: relative;\n  }\n\n  /* ── ANIMATIONS ── */\n  @keyframes fadeUp {\n    to { opacity: 1; transform: translateY(0); }\n  }\n  @keyframes pulse {\n    0%, 100% { box-shadow: 0 0 0 0 rgba(61,107,74,0.35); }\n    50%       { box-shadow: 0 0 0 5px rgba(61,107,74,0); }\n  }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 600px) {\n    .pc-hero h1 { font-size: 34px; }\n    .pc-section h2 { font-size: 26px; }\n    .pc-varieties { grid-template-columns: 1fr; }\n    .pc-inner { padding: 0 20px; }\n    .pc-hero { padding: 52px 20px 44px; }\n    .pc-section { padding: 48px 0; }\n    .pc-result { padding: 20px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pc-hero h1, .pc-hero p, .pc-badge { animation: none; opacity: 1; transform: none; }\n    .pc-section { opacity: 1; transform: none; transition: none; }\n    .pc-var:hover { transform: none; }\n  }\n</style>\n\n<div class=\"pc-wrap\">\n\n  <!-- HERO -->\n  <div class=\"pc-hero\">\n    <h1>Transparency<br>You Can <em>Verify</em></h1>\n    <p>At PRONTO CHOCHO, quality starts with transparency. Because our products are made from real whole-food ingredients, we independently test them through Eurofins — one of the world's leading food testing laboratories — for gluten, lectins, glyphosate, and heavy metals.</p>\n    <div class=\"pc-badge\">\n      <span class=\"pc-badge-dot\"></span>\n      Independently tested by Eurofins\n    </div>\n  </div>\n\n  <div class=\"pc-inner\">\n\n    <!-- GLYPHOSATE -->\n    <div class=\"pc-section\">\n      <h2>Glyphosate <em>Testing</em></h2>\n      <div class=\"pc-body\">\n        <p>PRONTO CHOCHO products are independently tested for glyphosate through Eurofins. Testing found glyphosate below the laboratory's reporting limit in our products.</p>\n        <p>Testing also found AMPA, glufosinate, and related metabolites below the laboratory's reporting limits. The tested products also met U.S. EPA and European Union pesticide requirements.</p>\n      </div>\n      <div class=\"pc-result\">\n        <div class=\"pc-result-label\">Result</div>\n        <div class=\"pc-pills\">\n          <span class=\"pc-pill\">Glyphosate &lt;0.01 mg/kg</span>\n          <span class=\"pc-pill\">AMPA below reporting limit</span>\n          <span class=\"pc-pill\">Glufosinate below reporting limit</span>\n        </div>\n        <div class=\"pc-result-note\">Meets both U.S. EPA and European Union pesticide requirements.</div>\n      </div>\n    </div>\n\n    <div class=\"pc-rule\">✦</div>\n\n    <!-- GLUTEN -->\n    <div class=\"pc-section\">\n      <h2>Gluten <em>Testing</em></h2>\n      <div class=\"pc-body\">\n        <p>PRONTO CHOCHO products are independently tested for gluten through Eurofins. Testing found gluten at &lt;3 ppm — well below the internationally recognized 20 ppm threshold for gluten-free foods.</p>\n        <p>This independent testing helps verify that our products meet the internationally recognized gluten-free standard while reinforcing our commitment to quality and transparency.</p>\n      </div>\n      <div class=\"pc-result\">\n        <div class=\"pc-result-label\">Result</div>\n        <div class=\"pc-pills\">\n          <span class=\"pc-pill\">Gluten &lt;3 ppm</span>\n        </div>\n        <div class=\"pc-result-note\">Gluten-free threshold is 20 ppm (international standard). Our products test at less than 3 ppm — over 85% below the recognized limit.</div>\n      </div>\n    </div>\n\n    <div class=\"pc-rule\">✦</div>\n\n    <!-- LECTINS -->\n    <div class=\"pc-section\">\n      <h2>Lectin <em>Testing</em></h2>\n      <div class=\"pc-body\">\n        <p>Like many legumes, raw chocho naturally contains lectins. Traditional Andean preparation greatly reduces these naturally occurring compounds before the chocho is consumed.</p>\n        <p>To help verify the quality of our products, PRONTO CHOCHO independently tests for lectins through Eurofins.</p>\n      </div>\n      <div class=\"pc-result\">\n        <div class=\"pc-result-label\">Result</div>\n        <div class=\"pc-pills\">\n          <span class=\"pc-pill\">Lectins &lt;0.05 mg/g</span>\n        </div>\n        <div class=\"pc-result-note\">Testing found lectin levels below the laboratory's reporting limit — a direct reflection of our traditional Andean debittering process.</div>\n      </div>\n    </div>\n\n    <div class=\"pc-rule\">✦</div>\n\n    <!-- HEAVY METALS -->\n    <div class=\"pc-section\">\n      <h2>Heavy Metal <em>Testing</em></h2>\n      <div class=\"pc-body\">\n        <p>Every PRONTO CHOCHO variety is independently tested for the four heavy metals most commonly monitored in foods: lead, cadmium, mercury, and arsenic. All three products complied with applicable European food safety regulations.</p>\n      </div>\n\n      <div class=\"pc-why\">\n        <div class=\"pc-why-label\">Why do results vary between varieties?</div>\n        <p>PRONTO CHOCHO products are made from real whole-food ingredients. Because plants naturally absorb minerals from the soil where they grow, every ingredient has its own unique mineral profile. As a result, each blend naturally differs slightly in its mineral composition. This is a normal characteristic of whole foods — and one of the reasons we independently test every variety.</p>\n      </div>\n\n      <div class=\"pc-varieties\">\n        <div class=\"pc-var pc-var--purple\">\n          <div class=\"pc-var-head\">Pure Andean<br>Chocho Powder</div>\n          <table>\n            <tr><td>Arsenic (As)</td><td>&lt;0.02 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>&lt;0.01 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>&lt;0.01 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"pc-var-note\">All four metals below the laboratory's reporting limits.</div>\n        </div>\n        <div class=\"pc-var pc-var--terra\">\n          <div class=\"pc-var-head\">Chocho <em>with</em><br>Ginger + Turmeric + Black Pepper</div>\n          <table>\n            <tr><td>Arsenic (As)</td><td>&lt;0.02 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>0.019 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>0.013 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"pc-var-note\">Profile reflects natural mineral contribution of ginger, turmeric &amp; black pepper.</div>\n        </div>\n        <div class=\"pc-var pc-var--sage\">\n          <div class=\"pc-var-head\">Chocho <em>with</em><br>Cacao + Spirulina + Maca</div>\n          <table>\n            <tr><td>Arsenic (As)</td><td>0.066 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>1.0 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>0.094 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"pc-var-note\">Cacao and spirulina naturally contribute a distinct mineral profile.</div>\n        </div>\n      </div>\n\n      <div class=\"pc-comply\">All three varieties complied with applicable European food safety regulations.</div>\n    </div>\n\n  </div>\n\n  <!-- CLOSING -->\n  <div class=\"pc-closing\">\n    <p>Because when it comes to real food,<br><em>transparency</em> should be part of every serving.</p>\n    <div class=\"pc-closing-line\"></div>\n    <div class=\"pc-closing-brand\">— PRONTO CHOCHO —</div>\n  </div>\n\n</div>\n\n<script>\n  const sections = document.querySelectorAll('.pc-section');\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('visible');\n        observer.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.12 });\n  sections.forEach(s => observer.observe(s));\n</script>",
