    "custom_liquid_MjFAPX": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Quality & Testing — PRONTO CHOCHO</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Jost:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n\n  <style>\n    /* ─── TOKENS ─────────────────────────────────────────────── */\n    :root {\n      --cream:       #F7F2EA;\n      --cream-dark:  #EDE5D8;\n      --ink:         #1C1A17;\n      --ink-mid:     #4A4740;\n      --ink-light:   #7C7970;\n      --purple:      #6C4D6E;\n      --terracotta:  #B25A45;\n      --sage:        #5E7060;\n      --gold:        #A07840;\n      --pass:        #3D6B4A;\n      --pass-bg:     #EBF4EE;\n      --border:      #D9D0C2;\n      --white:       #FDFAF5;\n\n      --serif:       'Cormorant Garamond', Georgia, serif;\n      --sans:        'Jost', system-ui, sans-serif;\n    }\n\n    /* ─── RESET ──────────────────────────────────────────────── */\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    /* ─── BASE ───────────────────────────────────────────────── */\n    body {\n      background: var(--cream);\n      color: var(--ink);\n      font-family: var(--sans);\n      font-size: 16px;\n      line-height: 1.7;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    /* ─── LAYOUT ─────────────────────────────────────────────── */\n    .container {\n      max-width: 900px;\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n\n    /* ─── HERO ───────────────────────────────────────────────── */\n    .hero {\n      text-align: center;\n      padding: 80px 24px 64px;\n      border-bottom: 1px solid var(--border);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .hero::before {\n      content: '';\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(ellipse 70% 60% at 50% 0%, #DDD0BE55 0%, transparent 70%);\n      pointer-events: none;\n    }\n\n    .hero-eyebrow {\n      font-family: var(--sans);\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: var(--terracotta);\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 12px;\n    }\n\n    .hero-eyebrow::before,\n    .hero-eyebrow::after {\n      content: '';\n      display: block;\n      width: 36px;\n      height: 1px;\n      background: var(--terracotta);\n      opacity: 0.5;\n    }\n\n    .hero h1 {\n      font-family: var(--serif);\n      font-size: clamp(2.6rem, 6vw, 4.2rem);\n      font-weight: 500;\n      line-height: 1.08;\n      color: var(--ink);\n      letter-spacing: -0.01em;\n      margin-bottom: 28px;\n    }\n\n    .hero h1 em {\n      font-style: italic;\n      color: var(--purple);\n    }\n\n    .hero-lead {\n      font-size: 1.05rem;\n      color: var(--ink-mid);\n      max-width: 640px;\n      margin: 0 auto 36px;\n      line-height: 1.75;\n    }\n\n    .eurofins-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      background: var(--white);\n      border: 1px solid var(--border);\n      border-radius: 40px;\n      padding: 10px 20px;\n      font-size: 12px;\n      font-weight: 600;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: var(--ink-mid);\n    }\n\n    .eurofins-badge .dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--pass);\n    }\n\n    /* ─── SECTION COMMON ─────────────────────────────────────── */\n    .section {\n      padding: 72px 0;\n      border-bottom: 1px solid var(--border);\n    }\n\n    .section:last-of-type {\n      border-bottom: none;\n    }\n\n    .section-header {\n      display: flex;\n      align-items: flex-start;\n      gap: 20px;\n      margin-bottom: 36px;\n    }\n\n    .section-icon {\n      flex-shrink: 0;\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n      margin-top: 4px;\n    }\n\n    .section-icon--purple { background: #6C4D6E18; }\n    .section-icon--sage   { background: #5E706018; }\n    .section-icon--gold   { background: #A0784018; }\n    .section-icon--terra  { background: #B25A4518; }\n\n    .section-title {\n      font-family: var(--serif);\n      font-size: clamp(1.6rem, 3.5vw, 2.2rem);\n      font-weight: 500;\n      line-height: 1.2;\n      color: var(--ink);\n    }\n\n    .section-subtitle {\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--ink-light);\n      margin-bottom: 6px;\n    }\n\n    .section-body {\n      font-size: 0.95rem;\n      color: var(--ink-mid);\n      line-height: 1.8;\n    }\n\n    .section-body p + p {\n      margin-top: 14px;\n    }\n\n    /* ─── RESULT CARD ────────────────────────────────────────── */\n    .result-card {\n      background: var(--white);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 28px 32px;\n      margin-top: 28px;\n    }\n\n    .result-card__label {\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--ink-light);\n      margin-bottom: 12px;\n    }\n\n    .result-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background: var(--pass-bg);\n      color: var(--pass);\n      border: 1px solid #C2DCC9;\n      border-radius: 30px;\n      padding: 8px 16px;\n      font-size: 0.9rem;\n      font-weight: 600;\n    }\n\n    .result-pill .check {\n      font-size: 14px;\n    }\n\n    .result-note {\n      margin-top: 16px;\n      font-size: 0.875rem;\n      color: var(--ink-light);\n      font-style: italic;\n      line-height: 1.6;\n    }\n\n    /* ─── HEAVY METALS ───────────────────────────────────────── */\n    .hm-intro {\n      font-size: 0.95rem;\n      color: var(--ink-mid);\n      line-height: 1.8;\n      margin-bottom: 12px;\n    }\n\n    .hm-why {\n      background: var(--cream-dark);\n      border-left: 3px solid var(--gold);\n      border-radius: 0 8px 8px 0;\n      padding: 20px 24px;\n      margin: 32px 0;\n      font-size: 0.9rem;\n      color: var(--ink-mid);\n      line-height: 1.75;\n    }\n\n    .hm-why strong {\n      display: block;\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.15em;\n      text-transform: uppercase;\n      color: var(--gold);\n      margin-bottom: 8px;\n    }\n\n    .variety-grid {\n      display: grid;\n      gap: 20px;\n      margin-top: 32px;\n    }\n\n    @media (min-width: 680px) {\n      .variety-grid { grid-template-columns: repeat(3, 1fr); }\n    }\n\n    .variety-card {\n      background: var(--white);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      overflow: hidden;\n    }\n\n    .variety-card__header {\n      padding: 16px 20px;\n      font-family: var(--serif);\n      font-size: 1rem;\n      font-weight: 600;\n      line-height: 1.3;\n      border-bottom: 1px solid var(--border);\n    }\n\n    .variety-card__header em {\n      font-style: italic;\n      font-weight: 400;\n    }\n\n    .variety-card--pure   .variety-card__header { color: var(--ink); border-top: 3px solid var(--purple); }\n    .variety-card--ginger .variety-card__header { color: var(--ink); border-top: 3px solid var(--terracotta); }\n    .variety-card--cacao  .variety-card__header { color: var(--ink); border-top: 3px solid var(--sage); }\n\n    .variety-card__table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 0.82rem;\n    }\n\n    .variety-card__table tr:not(:last-child) {\n      border-bottom: 1px solid var(--border);\n    }\n\n    .variety-card__table td {\n      padding: 9px 20px;\n      color: var(--ink-mid);\n    }\n\n    .variety-card__table td:first-child {\n      color: var(--ink);\n      font-weight: 500;\n    }\n\n    .variety-card__table td:last-child {\n      text-align: right;\n      font-family: 'Courier New', monospace;\n      font-size: 0.78rem;\n      letter-spacing: 0.04em;\n      color: var(--pass);\n      font-weight: 600;\n    }\n\n    .variety-card__interpretation {\n      padding: 12px 20px;\n      font-size: 0.775rem;\n      color: var(--ink-light);\n      line-height: 1.6;\n      background: var(--cream);\n      border-top: 1px solid var(--border);\n      font-style: italic;\n    }\n\n    .comply-badge {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 28px;\n      font-size: 0.85rem;\n      color: var(--pass);\n      font-weight: 500;\n    }\n\n    .comply-badge::before {\n      content: '✓';\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: var(--pass-bg);\n      border: 1px solid #C2DCC9;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 12px;\n      flex-shrink: 0;\n    }\n\n    /* ─── CLOSING STATEMENT ──────────────────────────────────── */\n    .closing {\n      text-align: center;\n      padding: 80px 24px;\n      background: var(--ink);\n      color: var(--cream);\n    }\n\n    .closing-quote {\n      font-family: var(--serif);\n      font-size: clamp(1.5rem, 4vw, 2.4rem);\n      font-weight: 400;\n      font-style: italic;\n      line-height: 1.35;\n      max-width: 640px;\n      margin: 0 auto 32px;\n      color: #F0EAE0;\n    }\n\n    .closing-quote em {\n      color: #C8A87A;\n      font-style: normal;\n    }\n\n    .closing-divider {\n      width: 48px;\n      height: 1px;\n      background: #C8A87A;\n      opacity: 0.5;\n      margin: 0 auto 28px;\n    }\n\n    .closing-brand {\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: #7C7970;\n    }\n\n    /* ─── FAQ SNIPPET ────────────────────────────────────────── */\n    .faq-snippet {\n      background: var(--white);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 0;\n      margin-top: 48px;\n      overflow: hidden;\n    }\n\n    .faq-snippet__label {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 16px 24px;\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--ink-light);\n      background: var(--cream-dark);\n      border-bottom: 1px solid var(--border);\n    }\n\n    .faq-snippet__label span {\n      background: var(--terracotta);\n      color: white;\n      border-radius: 4px;\n      padding: 2px 8px;\n      font-size: 10px;\n    }\n\n    .faq-item {\n      padding: 24px;\n    }\n\n    .faq-q {\n      font-family: var(--serif);\n      font-size: 1.1rem;\n      font-weight: 600;\n      color: var(--ink);\n      margin-bottom: 10px;\n      line-height: 1.4;\n    }\n\n    .faq-a {\n      font-size: 0.9rem;\n      color: var(--ink-mid);\n      line-height: 1.75;\n    }\n\n    .faq-a a {\n      color: var(--terracotta);\n      text-decoration: none;\n      font-weight: 500;\n      border-bottom: 1px solid currentColor;\n      padding-bottom: 1px;\n    }\n\n    /* ─── DIVIDER ────────────────────────────────────────────── */\n    .ornament {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 12px;\n      color: var(--border);\n      font-size: 18px;\n      margin: 8px 0;\n    }\n\n    .ornament::before,\n    .ornament::after {\n      content: '';\n      flex: 1;\n      height: 1px;\n      background: var(--border);\n    }\n\n    /* ─── RESPONSIVE ─────────────────────────────────────────── */\n    @media (max-width: 600px) {\n      .hero { padding: 56px 20px 48px; }\n      .section { padding: 52px 0; }\n      .section-header { flex-direction: column; gap: 12px; }\n      .result-card { padding: 20px; }\n      .variety-card__table td { padding: 8px 14px; }\n      .closing { padding: 60px 20px; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- ══ HERO ══════════════════════════════════════════════════ -->\n  <section class=\"hero\">\n    <div class=\"hero-eyebrow\">Independent Testing</div>\n    <h1>Transparency<br>You Can <em>Verify</em></h1>\n    <p class=\"hero-lead\">\n      At PRONTO CHOCHO, quality starts with transparency. Because our products are made from real whole-food ingredients, we independently test them through Eurofins — one of the world's leading food testing laboratories — for key quality and safety parameters including gluten, lectins, glyphosate, and heavy metals.\n    </p>\n    <div class=\"eurofins-badge\">\n      <span class=\"dot\"></span>\n      Independently tested by Eurofins\n    </div>\n  </section>\n\n  <!-- ══ CONTENT ════════════════════════════════════════════════ -->\n  <div class=\"container\">\n\n    <!-- ── GLYPHOSATE ── -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon section-icon--sage\">🌿</div>\n        <div>\n          <p class=\"section-subtitle\">Pesticide Testing</p>\n          <h2 class=\"section-title\">Glyphosate Testing</h2>\n        </div>\n      </div>\n      <div class=\"section-body\">\n        <p>PRONTO CHOCHO products are independently tested for glyphosate through Eurofins. Testing found glyphosate below the laboratory's reporting limit in our products.</p>\n        <p>Testing also found AMPA, glufosinate, and related metabolites below the laboratory's reporting limits. The tested products also met U.S. EPA and European Union pesticide requirements.</p>\n      </div>\n\n      <div class=\"result-card\">\n        <p class=\"result-card__label\">Result</p>\n        <div style=\"display:flex; flex-wrap:wrap; gap:10px;\">\n          <span class=\"result-pill\"><span class=\"check\">✓</span> Glyphosate &lt;0.01 mg/kg</span>\n          <span class=\"result-pill\"><span class=\"check\">✓</span> AMPA below reporting limit</span>\n          <span class=\"result-pill\"><span class=\"check\">✓</span> Glufosinate below reporting limit</span>\n        </div>\n        <p class=\"result-note\">Meets both U.S. EPA and European Union pesticide requirements.</p>\n      </div>\n    </section>\n\n    <div class=\"ornament\">✦</div>\n\n    <!-- ── GLUTEN ── -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon section-icon--purple\">🌾</div>\n        <div>\n          <p class=\"section-subtitle\">Allergen Testing</p>\n          <h2 class=\"section-title\">Gluten Testing</h2>\n        </div>\n      </div>\n      <div class=\"section-body\">\n        <p>PRONTO CHOCHO products are independently tested for gluten through Eurofins. Testing found gluten at &lt;3 ppm, well below the internationally recognized 20 ppm threshold for gluten-free foods.</p>\n        <p>This independent testing helps verify that our products meet the internationally recognized gluten-free standard while reinforcing our commitment to quality and transparency.</p>\n      </div>\n\n      <div class=\"result-card\">\n        <p class=\"result-card__label\">Result</p>\n        <div style=\"display:flex; flex-wrap:wrap; gap:10px; align-items: center;\">\n          <span class=\"result-pill\"><span class=\"check\">✓</span> Gluten &lt;3 ppm</span>\n        </div>\n        <p class=\"result-note\">Gluten-free threshold: 20 ppm (international standard). Our products test at less than 3 ppm — over 85% below the recognized threshold.</p>\n      </div>\n    </section>\n\n    <div class=\"ornament\">✦</div>\n\n    <!-- ── LECTINS ── -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon section-icon--gold\">🫘</div>\n        <div>\n          <p class=\"section-subtitle\">Naturally Occurring Compounds</p>\n          <h2 class=\"section-title\">Lectin Testing</h2>\n        </div>\n      </div>\n      <div class=\"section-body\">\n        <p>Like many legumes, raw chocho naturally contains lectins. Traditional Andean preparation greatly reduces these naturally occurring compounds before the chocho is consumed.</p>\n        <p>To help verify the quality of our products, PRONTO CHOCHO independently tests for lectins through Eurofins.</p>\n      </div>\n\n      <div class=\"result-card\">\n        <p class=\"result-card__label\">Result</p>\n        <div style=\"display:flex; flex-wrap:wrap; gap:10px;\">\n          <span class=\"result-pill\"><span class=\"check\">✓</span> Lectins &lt;0.05 mg/g</span>\n        </div>\n        <p class=\"result-note\">Testing found lectin levels below the laboratory's reporting limit — a direct reflection of our traditional Andean debittering process.</p>\n      </div>\n    </section>\n\n    <div class=\"ornament\">✦</div>\n\n    <!-- ── HEAVY METALS ── -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon section-icon--terra\">⚗️</div>\n        <div>\n          <p class=\"section-subtitle\">Safety Testing</p>\n          <h2 class=\"section-title\">Heavy Metal Testing</h2>\n        </div>\n      </div>\n\n      <p class=\"hm-intro\">Every PRONTO CHOCHO variety is independently tested for the four heavy metals most commonly monitored in foods: lead, cadmium, mercury, and arsenic. All three products complied with applicable European food safety regulations.</p>\n\n      <div class=\"hm-why\">\n        <strong>Why do results vary between varieties?</strong>\n        PRONTO CHOCHO products are made from real whole-food ingredients. Because plants naturally absorb minerals from the soil where they grow, every ingredient has its own unique mineral profile. As a result, each blend naturally differs slightly in its mineral composition. This is a normal characteristic of whole foods — and one of the reasons we independently test every variety.\n      </div>\n\n      <div class=\"variety-grid\">\n\n        <!-- Pure -->\n        <div class=\"variety-card variety-card--pure\">\n          <div class=\"variety-card__header\">\n            Pure Andean<br>Chocho Powder\n          </div>\n          <table class=\"variety-card__table\">\n            <tr><td>Arsenic (As)</td><td>&lt;0.02 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>&lt;0.01 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>&lt;0.01 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"variety-card__interpretation\">\n            All four metals below the laboratory's reporting limits.\n          </div>\n        </div>\n\n        <!-- Ginger -->\n        <div class=\"variety-card variety-card--ginger\">\n          <div class=\"variety-card__header\">\n            Chocho <em>with</em><br>Ginger + Turmeric + Black Pepper\n          </div>\n          <table class=\"variety-card__table\">\n            <tr><td>Arsenic (As)</td><td>&lt;0.02 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>0.019 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>0.013 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"variety-card__interpretation\">\n            Slightly different profile due to ginger, turmeric & black pepper. Fully compliant with EU food safety regulations.\n          </div>\n        </div>\n\n        <!-- Cacao -->\n        <div class=\"variety-card variety-card--cacao\">\n          <div class=\"variety-card__header\">\n            Chocho <em>with</em><br>Cacao + Spirulina + Maca\n          </div>\n          <table class=\"variety-card__table\">\n            <tr><td>Arsenic (As)</td><td>0.066 mg/kg</td></tr>\n            <tr><td>Cadmium (Cd)</td><td>1.0 mg/kg</td></tr>\n            <tr><td>Lead (Pb)</td><td>0.094 mg/kg</td></tr>\n            <tr><td>Mercury (Hg)</td><td>&lt;0.01 mg/kg</td></tr>\n          </table>\n          <div class=\"variety-card__interpretation\">\n            Cacao and spirulina naturally contribute a distinct mineral profile. Fully compliant with EU food safety regulations.\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"comply-badge\">\n        All three varieties complied with applicable European food safety regulations.\n      </div>\n\n      <!-- FAQ snippet -->\n      <div class=\"faq-snippet\">\n        <div class=\"faq-snippet__label\">\n          <span>FAQ</span>\n          Suggested addition to FAQ page\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"faq-q\">Has PRONTO CHOCHO been independently tested for heavy metals?</p>\n          <p class=\"faq-a\">Yes. Every PRONTO CHOCHO variety is independently tested by Eurofins for lead, cadmium, mercury, and arsenic as part of our commitment to quality and transparency. <a href=\"#\">Visit our Quality &amp; Testing page</a> to view the complete test results.</p>\n        </div>\n      </div>\n\n    </section>\n\n  </div><!-- /container -->\n\n  <!-- ══ CLOSING ════════════════════════════════════════════════ -->\n  <footer class=\"closing\">\n    <p class=\"closing-quote\">\n      Because when it comes to real food,<br>\n      <em>transparency</em> should be part of every serving.\n    </p>\n    <div class=\"closing-divider\"></div>\n    <p class=\"closing-brand\">PRONTO CHOCHO — Andean Pacha, LLC</p>\n  </footer>\n\n</body>\n</html>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
